<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AIArena.CodeIntelligence\AIArena.CodeIntelligence.csproj" />
    <ProjectReference Include="..\..\src\AIArena.Wpf\AIArena.Wpf.csproj" />
    <ProjectReference Include="..\AIArena.VerificationLab\AIArena.VerificationLab.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <!-- Library-hosted modal dialogs resolve their window icon from the entry assembly. -->
    <Resource Include="..\..\src\AIArena.Wpf\Assets\ai-arena-icon.ico" Link="Assets\ai-arena-icon.ico" />
  </ItemGroup>
</Project>
