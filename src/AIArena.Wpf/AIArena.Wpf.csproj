<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AI Arena</AssemblyName>
    <Product>AI Arena</Product>
    <Version>0.4.134-beta</Version>
    <InformationalVersion>0.4.134-beta</InformationalVersion>
    <FileVersion>0.4.134.0</FileVersion>
    <ApplicationIcon>Assets\ai-arena-icon.ico</ApplicationIcon>
    <!-- Profile-guided tiering costs nothing at build time and improves steady-state JIT. -->
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIArena.CodeIntelligence\AIArena.CodeIntelligence.csproj" />
    <ProjectReference Include="..\AIArena.Core\AIArena.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ai-arena-icon.ico" />
    <Resource Include="Assets\ai-arena-guide-icon.png" />
    <Resource Include="Assets\ai-arena-emblem-transparent.png" />
    <Resource Include="Assets\Avatars\robot_heads_48.png" />
    <Resource Include="Assets\Avatars\robot_heads_48.json" />
    <Resource Include="Assets\Avatars\system_avatar.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\ai-arena-icon.ico" LogicalName="assets/ai-arena-icon.ico" />
    <EmbeddedResource Include="Assets\ai-arena-guide-icon.png" LogicalName="assets/ai-arena-guide-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-app Help Center is fully offline. Keep its structured source as
         ordinary published content so installed articles, search metadata, and
         the portable USER_GUIDE.md can be validated from the same files. -->
    <Content Include="Help\Content\**\*.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Help\Content\**\*.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Help\Content\assets\**\*.png;Help\Content\assets\**\*.jpg;Help\Content\assets\**\*.jpeg;Help\Content\assets\**\*.webp"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.8" />
    <PackageReference Include="System.Speech" Version="10.0.9" />
  </ItemGroup>

</Project>
