<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        AI Arena design tokens

        All keys are namespaced so this dictionary can coexist with the legacy
        window-level palette during the interface migration. Dimensions use
        device-independent pixels and therefore continue to scale with WPF DPI.
    -->

    <!-- Type scale: compact enough for dense agent work, with a clear hierarchy. -->
    <FontFamily x:Key="Arena.Type.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Arena.Type.DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- Fluent glyphs on Windows 11 with the same code points falling back to MDL2 on Windows 10. -->
    <FontFamily x:Key="Arena.Type.IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="Arena.Type.DisplaySize">22</sys:Double>
    <sys:Double x:Key="Arena.Type.PageTitleSize">20</sys:Double>
    <sys:Double x:Key="Arena.Type.TitleSize">17</sys:Double>
    <sys:Double x:Key="Arena.Type.HeadingSize">14</sys:Double>
    <sys:Double x:Key="Arena.Type.BodySize">12.5</sys:Double>
    <sys:Double x:Key="Arena.Type.CompactBodySize">12</sys:Double>
    <sys:Double x:Key="Arena.Type.LabelSize">11.5</sys:Double>
    <sys:Double x:Key="Arena.Type.DenseLabelSize">11</sys:Double>
    <sys:Double x:Key="Arena.Type.CaptionSize">10.5</sys:Double>
    <sys:Double x:Key="Arena.Type.MicroSize">10</sys:Double>

    <!--
        Scalar lengths are for Width, Height, offsets, and code-behind. WPF
        Margin and Padding require Thickness resources; never change these keys'
        type to make them fit those properties.
    -->
    <sys:Double x:Key="Arena.Space.1">4</sys:Double>
    <sys:Double x:Key="Arena.Space.2">8</sys:Double>
    <sys:Double x:Key="Arena.Space.3">10</sys:Double>
    <sys:Double x:Key="Arena.Space.4">12</sys:Double>
    <sys:Double x:Key="Arena.Space.5">16</sys:Double>
    <sys:Double x:Key="Arena.Space.6">20</sys:Double>
    <sys:Double x:Key="Arena.Space.8">24</sys:Double>
    <Thickness x:Key="Arena.Inset.Control">8,4</Thickness>
    <Thickness x:Key="Arena.Inset.Micro">4</Thickness>
    <Thickness x:Key="Arena.Inset.Compact">8</Thickness>
    <Thickness x:Key="Arena.Inset.Dense">9</Thickness>
    <Thickness x:Key="Arena.Inset.Card">10</Thickness>
    <Thickness x:Key="Arena.Inset.Panel">12</Thickness>
    <Thickness x:Key="Arena.Inset.Section">14</Thickness>
    <Thickness x:Key="Arena.Inset.None">0</Thickness>

    <!-- Component insets measured from the established compact interface. -->
    <Thickness x:Key="Arena.Inset.RailAction">7,4</Thickness>
    <Thickness x:Key="Arena.Inset.NavigationItem">9,0</Thickness>
    <Thickness x:Key="Arena.Inset.RailContext">10,9</Thickness>
    <Thickness x:Key="Arena.Inset.QuickAction">10,4</Thickness>
    <Thickness x:Key="Arena.Inset.MatchSetupAction">11,6</Thickness>
    <Thickness x:Key="Arena.Inset.Action">10,6</Thickness>
    <Thickness x:Key="Arena.Inset.CompactAction">8,6</Thickness>
    <Thickness x:Key="Arena.Inset.Tab">7,5</Thickness>
    <Thickness x:Key="Arena.Inset.StatusCard">10,7</Thickness>
    <Thickness x:Key="Arena.Inset.InteractiveCard">12,10</Thickness>
    <Thickness x:Key="Arena.Inset.StatusChip">8,3</Thickness>
    <Thickness x:Key="Arena.Inset.StatusChipCompact">6,2</Thickness>
    <Thickness x:Key="Arena.Inset.Menu">3</Thickness>
    <Thickness x:Key="Arena.Inset.MenuItem">10,5</Thickness>
    <Thickness x:Key="Arena.Inset.ListItem">9,7</Thickness>
    <Thickness x:Key="Arena.Inset.PageHeader">16,12</Thickness>
    <Thickness x:Key="Arena.Inset.PageHeader.Compact">0,3,0,6</Thickness>
    <Thickness x:Key="Arena.Inset.ToolbarAction">10,0</Thickness>
    <Thickness x:Key="Arena.Inset.StatusDock">10,8</Thickness>
    <Thickness x:Key="Arena.Layout.TopBarMargin">10,3</Thickness>
    <Thickness x:Key="Arena.Layout.StatusDockBleed">-10,8,-10,-10</Thickness>
    <Thickness x:Key="Arena.Layout.RailButtonGridBleed">0,8,-6,0</Thickness>
    <Thickness x:Key="Arena.Layout.RailContextBleed">-10,6,-10,8</Thickness>
    <Thickness x:Key="Arena.Layout.RailSectionMargin">0,12,0,6</Thickness>

    <!--
        Directional layout tokens preserve the current geometry exactly. Before
        and After describe item order in an LTR inline flow or top-to-bottom
        stack; the values remain physical WPF Thickness values.
    -->
    <Thickness x:Key="Arena.Gap.Inline.Before.Nano">2,0,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Inline.Before.Tight">5,0,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Inline.Before.Compact">6,0,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Inline.Before.CompactPlus">7,0,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Inline.Before.Default">8,0,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Inline.Before.Comfortable">10,0,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Inline.Before.Spacious">12,0,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Inline.After.Tight">0,0,5,0</Thickness>
    <Thickness x:Key="Arena.Gap.Inline.After.Compact">0,0,6,0</Thickness>
    <Thickness x:Key="Arena.Gap.Inline.After.Default">0,0,8,0</Thickness>
    <Thickness x:Key="Arena.Gap.Inline.After.Spacious">0,0,12,0</Thickness>
    <Thickness x:Key="Arena.Gap.Wrap.After.Compact">0,0,6,6</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.Before.Nano">0,2,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.Before.Micro">0,3,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.Before.Tight">0,4,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.Before.TightPlus">0,5,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.Before.Compact">0,6,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.Before.CompactPlus">0,7,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.Before.Default">0,8,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.Before.DefaultPlus">0,9,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.Before.Comfortable">0,10,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.Before.Section">0,12,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.After.Nano">0,0,0,2</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.After.Tight">0,0,0,4</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.After.TightPlus">0,0,0,5</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.After.Compact">0,0,0,6</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.After.CompactPlus">0,0,0,7</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.After.Default">0,0,0,8</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.After.DefaultPlus">0,0,0,9</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.After.Comfortable">0,0,0,10</Thickness>
    <Thickness x:Key="Arena.Gap.Stack.After.Section">0,0,0,12</Thickness>

    <!-- Reusable workspace geometry for the experiment and inspection surfaces. -->
    <Thickness x:Key="Arena.Layout.FormFieldMargin">0,2,0,10</Thickness>
    <Thickness x:Key="Arena.Layout.CaptionSectionMargin">0,3,0,10</Thickness>
    <Thickness x:Key="Arena.Layout.CaptionBlockMargin">0,3,0,8</Thickness>
    <Thickness x:Key="Arena.Layout.ActionSectionMargin">0,4,0,10</Thickness>
    <Thickness x:Key="Arena.Layout.InsetSectionMargin">0,2,0,8</Thickness>
    <Thickness x:Key="Arena.Layout.FieldLabelMargin">0,6,0,4</Thickness>
    <Thickness x:Key="Arena.Layout.SectionHeadingMargin">0,12,0,8</Thickness>
    <Thickness x:Key="Arena.Layout.FeatureSectionMargin">2,0,0,10</Thickness>
    <Thickness x:Key="Arena.Layout.FeatureHeaderMargin">2,2,2,10</Thickness>
    <Thickness x:Key="Arena.Layout.WorkspaceHeaderMargin">4,2,4,10</Thickness>
    <Thickness x:Key="Arena.Layout.WorkspaceStatusMargin">4,0,4,10</Thickness>
    <Thickness x:Key="Arena.Layout.WorkspaceBodyMargin">4,0,4,4</Thickness>
    <Thickness x:Key="Arena.Layout.WorkspaceRootMargin">4,2,4,4</Thickness>
    <Thickness x:Key="Arena.Layout.WorkspaceDescriptionMargin">0,3,0,12</Thickness>
    <Thickness x:Key="Arena.Layout.InspectorDetailMargin">4,10,4,4</Thickness>
    <Thickness x:Key="Arena.Layout.PageHeaderMargin">0,0,0,12</Thickness>
    <Thickness x:Key="Arena.Layout.PageHeaderCompactMargin">0,0,0,6</Thickness>
    <Thickness x:Key="Arena.Layout.PageHeaderActionMargin">12,0,0,0</Thickness>
    <Thickness x:Key="Arena.Layout.StateCardMargin">0,0,8,8</Thickness>
    <Thickness x:Key="Arena.Layout.FeatureGroupHeaderMargin">4,10,4,5</Thickness>
    <Thickness x:Key="Arena.Layout.HeaderStatusMargin">10,1,0,0</Thickness>
    <sys:Double x:Key="Arena.Layout.HeaderStatusMaxWidth">300</sys:Double>
    <Thickness x:Key="Arena.Layout.MenuSeparatorMargin">8,4</Thickness>
    <Thickness x:Key="Arena.Layout.SkeletonLeadMargin">0,16,0,8</Thickness>

    <!-- Compatibility keys retained until their existing consumers migrate. -->
    <Thickness x:Key="Arena.Gap.Inline">6,0,0,0</Thickness>
    <Thickness x:Key="Arena.Gap.Stack">0,0,0,8</Thickness>
    <Thickness x:Key="Arena.Gap.Section">0,0,0,12</Thickness>

    <!-- Target sizes include the full hit surface, not only the visible glyph. -->
    <sys:Double x:Key="Arena.Target.Minimum">32</sys:Double>
    <sys:Double x:Key="Arena.Target.Primary">36</sys:Double>
    <sys:Double x:Key="Arena.Target.Compact">28</sys:Double>
    <sys:Double x:Key="Arena.Target.Icon">30</sys:Double>
    <sys:Double x:Key="Arena.ScrollBar.Thickness">12</sys:Double>
    <sys:Double x:Key="Arena.ScrollBar.MinimumThumbLength">32</sys:Double>

    <CornerRadius x:Key="Arena.Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Arena.Radius.Medium">8</CornerRadius>
    <CornerRadius x:Key="Arena.Radius.Large">12</CornerRadius>
    <CornerRadius x:Key="Arena.Radius.Pill">999</CornerRadius>

    <!--
        The design system deliberately uses static, trigger-driven state changes.
        This zero-duration token is available to consumers that require a
        Timeline while still respecting reduced-motion expectations.
    -->
    <Duration x:Key="Arena.Motion.StaticDuration">0:0:0</Duration>
    <Duration x:Key="Arena.Motion.QuickDuration">0:0:0.12</Duration>
    <Duration x:Key="Arena.Motion.FeedbackDuration">0:0:0.14</Duration>
    <Duration x:Key="Arena.Motion.DisclosureDuration">0:0:0.16</Duration>

    <!--
        Semantic accessibility brushes live in ThemeBrushes.xaml and are
        replaced from the active palette at runtime. Keeping them palette-bound
        is essential on Light, where the old fixed pastel values fell below 3:1.
    -->
    <SolidColorBrush x:Key="Arena.Brush.HoverOverlay" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Arena.Brush.PressedOverlay" Color="#1F000000" />

    <!-- Keyboard-only focus adorners keep pointer use quiet and keyboard use clear. -->
    <Style x:Key="Arena.FocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid Margin="-4"
                          IsHitTestVisible="False"
                          SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                BorderThickness="4"
                                CornerRadius="{DynamicResource Arena.Radius.Medium}"
                                Opacity="0.22" />
                        <Border Margin="2"
                                BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource Arena.Radius.Small}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
