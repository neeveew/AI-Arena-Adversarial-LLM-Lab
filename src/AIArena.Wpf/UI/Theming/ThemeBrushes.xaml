<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Startup and design-time defaults for the shell's themed brushes.

        ShellNavigationCoordinator.ApplyTheme writes every one of these keys into
        the window's own resources at startup, and the window shadows the
        application scope, so at runtime these values are replaced before the
        first frame. They matter for the XAML designer, and as the fallback for
        any lookup that happens before a theme is applied.

        The values mirror ThemePalette "dark-arena", which is the default theme.
        ThemeBrushDefaultsTests asserts that mirror still holds - three of these
        had already drifted from the palette while they lived in MainWindow.xaml,
        because nothing compared them.

        Every consumer references these through DynamicResource, which resolves
        element -> window -> application, so defining them here keeps the runtime
        override working exactly as before.
    -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101916" />
    <SolidColorBrush x:Key="TopBarBrush" Color="#1A2621" />
    <SolidColorBrush x:Key="PanelBrush" Color="#18231F" />
    <SolidColorBrush x:Key="CardBrush" Color="#14201B" />
    <SolidColorBrush x:Key="InputBrush" Color="#0D1714" />
    <SolidColorBrush x:Key="TranscriptHeaderBrush" Color="#18231F" />
    <SolidColorBrush x:Key="TranscriptBodyBrush" Color="#14201B" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4D6A5F" />
    <SolidColorBrush x:Key="TextBrush" Color="#DDE7E2" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B8C7BF" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#105444" />
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#2EA889" />
    <SolidColorBrush x:Key="AssistBrush" Color="#492337" />
    <SolidColorBrush x:Key="AssistBorderBrush" Color="#E17DB6" />
    <SolidColorBrush x:Key="DangerBrush" Color="#432827" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#D66F72" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF7B82" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#111917" />
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="#27342F" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6F7D76" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#56C0A2" />
    <!-- Blend(Input, PrimaryBorder, 0.18 / 0.24 / 0.12), computed by ThemePalette. -->
    <SolidColorBrush x:Key="NavHoverBrush" Color="#133129" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#153A30" />
    <SolidColorBrush x:Key="NavPressedBrush" Color="#112822" />
    <SolidColorBrush x:Key="PressedPrimaryBrush" Color="#0E3E34" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC1A2621" />
    <SolidColorBrush x:Key="AlphaAccentBrush" Color="#4DD4EF" />
    <SolidColorBrush x:Key="BetaAccentBrush" Color="#F0C36A" />
    <SolidColorBrush x:Key="GammaAccentBrush" Color="#7DD98B" />
    <SolidColorBrush x:Key="DeltaAccentBrush" Color="#9EA6FF" />
    <SolidColorBrush x:Key="NarratorAccentBrush" Color="#E17DB6" />
    <SolidColorBrush x:Key="OperatorAccentBrush" Color="#7FB7FF" />
</ResourceDictionary>
