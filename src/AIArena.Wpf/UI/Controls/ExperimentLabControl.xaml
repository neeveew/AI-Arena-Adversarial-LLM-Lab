<UserControl x:Class="AIArena.Wpf.Controls.ExperimentLabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AIArena.Wpf.Controls"
             MinWidth="480"
             MinHeight="320"
             Focusable="False"
             AutomationProperties.Name="Experiment Lab workspace"
             SizeChanged="ExperimentLabControl_SizeChanged">
    <UserControl.Resources>
        <!-- These local presentation styles keep the feature host independently
             constructible. Interactive controls adopt the shared Arena templates
             dynamically so production theme changes and accessibility states use
             the same chrome as the rest of the shell. -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="{DynamicResource Arena.Type.CompactBodySize}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="{DynamicResource Arena.Type.DenseLabelSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="{DynamicResource Arena.Gap.Stack.After.Tight}" />
        </Style>
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{DynamicResource Arena.Inset.CompactAction}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="ExperimentFeatureItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{DynamicResource Arena.Inset.StatusDock}" />
            <Setter Property="Margin" Value="{DynamicResource Arena.Gap.Stack.After.Tight}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Arena.FocusVisual}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding HelpText}" />
            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding RefreshStatusLabel}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Arena.Radius.Small}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource NavActiveBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExperimentCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Arena.Radius.Medium}" />
            <Setter Property="Padding" Value="{DynamicResource Arena.Inset.Section}" />
            <Setter Property="Margin" Value="{DynamicResource Arena.Gap.Stack.After.Comfortable}" />
        </Style>

        <Style x:Key="ExperimentStageCard" TargetType="Border" BasedOn="{StaticResource ExperimentCard}">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        </Style>

        <Style x:Key="ExperimentStatusChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Arena.Radius.Small}" />
            <Setter Property="Padding" Value="{DynamicResource Arena.Inset.StatusChipCompact}" />
        </Style>

        <Style x:Key="ExperimentEmptyState" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Arena.Radius.Small}" />
            <Setter Property="Padding" Value="{DynamicResource Arena.Inset.Card}" />
            <Setter Property="MinHeight" Value="64" />
        </Style>

        <Style x:Key="ExperimentTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource Arena.Type.PageTitleSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ExperimentSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource Arena.Type.HeadingSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="{DynamicResource Arena.Gap.Stack.After.Default}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:WorkspacePageHeaderControl x:Name="ExperimentWorkspaceHeader"
                                              Title="Experiment Lab"
                                               Description="Configure replayable local experiments, inspect bounded evidence, and review truthful feature refresh state."
                                               Status="{Binding SelectedItem.RefreshStatusLabel, ElementName=FeatureSelector}"
                                               StatusKind="{Binding SelectedItem.RefreshStatusKind, ElementName=FeatureSelector}"
                                              PrimaryActionText="Refresh selected"
                                              PrimaryActionAutomationName="Refresh selected Experiment Lab feature"
                                              PrimaryActionHelpText="Refresh only the currently selected feature while keeping grouped navigation available for supersession."
                                              PrimaryActionRequested="RefreshSelectedFeatureHeader_Click" />
    <Grid x:Name="LayoutRoot" Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="SelectorRow" Height="*" />
            <RowDefinition x:Name="CompactGapRow" Height="0" />
            <RowDefinition x:Name="ContentRow" Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SelectorColumn" Width="190" />
            <ColumnDefinition x:Name="WideGapColumn" Width="12" />
            <ColumnDefinition x:Name="ContentColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="FeatureSelectorFrame"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Arena.Radius.Medium}"
                Padding="{DynamicResource Arena.Inset.Card}"
                AutomationProperties.Name="Experiment Lab features">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource Arena.Layout.FeatureHeaderMargin}">
                    <TextBlock Text="Features"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="{DynamicResource Arena.Type.TitleSize}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Grouped workspaces"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource Arena.Type.DenseLabelSize}"
                               Margin="{DynamicResource Arena.Gap.Stack.Before.Nano}" />
                </StackPanel>
                <ListBox x:Name="FeatureSelector"
                         Style="{DynamicResource Arena.ListBox}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="FeatureSelector_SelectionChanged"
                         ItemContainerStyle="{StaticResource ExperimentFeatureItem}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         AutomationProperties.Name="Available Experiment Lab features">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource Arena.Type.MicroSize}"
                                               FontWeight="SemiBold"
                                               Margin="{DynamicResource Arena.Layout.FeatureGroupHeaderMargin}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="{Binding Name}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding HelpText}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="{Binding Summary}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="{DynamicResource Arena.Type.MicroSize}"
                                           Margin="{DynamicResource Arena.Gap.Stack.Before.Nano}"
                                           TextWrapping="Wrap" />
                                <Border Grid.Row="2" Style="{StaticResource ExperimentStatusChip}"
                                        HorizontalAlignment="Left"
                                        Margin="{DynamicResource Arena.Gap.Stack.Before.Tight}">
                                    <TextBlock Text="{Binding RefreshStatusLabel}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource Arena.Type.MicroSize}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid x:Name="FeatureContentGrid" Grid.Column="2">
            <Grid x:Name="MatrixPanel" Visibility="Collapsed" AutomationProperties.Name="Experiment Matrix Runner">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="{DynamicResource Arena.Layout.FeatureSectionMargin}">
                    <TextBlock Text="Experiment Matrix Runner" Style="{StaticResource ExperimentTitle}" />
                    <TextBlock Text="Build and validate a deterministic bounded matrix. Run becomes available only when the exact pack, session setup, and process-memory provider profiles resolve."
                               Style="{StaticResource HintText}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer x:Name="MatrixScrollViewer" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Matrix Runner stages">
                    <StackPanel>
                        <Border x:Name="MatrixConfigureStage" Style="{StaticResource ExperimentStageCard}"
                                AutomationProperties.Name="Matrix stage 1 Configure"
                                AutomationProperties.HelpText="Define the exact scenario, provider, dimension, rubric, and bounded execution inputs.">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource ExperimentStatusChip}"
                                            Background="{DynamicResource NavActiveBrush}"
                                            BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                            Margin="{DynamicResource Arena.Gap.Inline.After.Default}">
                                        <TextBlock Text="1" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource ExperimentStatusChip}">
                                        <TextBlock Text="Draft" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource Arena.Type.MicroSize}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Configure" Style="{StaticResource ExperimentSectionTitle}" Margin="{DynamicResource Arena.Inset.None}" />
                                        <TextBlock Text="Choose bounded inputs. Any change requires validation before Run becomes available."
                                                   Style="{StaticResource HintText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <Grid Margin="{DynamicResource Arena.Gap.Stack.Before.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MatrixTitleText" Text="Local comparison" Style="{StaticResource FormTextBox}" MaxLength="120"
                                                 TextChanged="MatrixConfiguration_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Scenario pack ID" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MatrixScenarioPackText" Text="" Style="{StaticResource FormTextBox}" MaxLength="160"
                                                 TextChanged="MatrixConfiguration_TextChanged"
                                                 AutomationProperties.HelpText="Filled from the canonical scenario-pack store when available." />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}">
                                        <TextBlock Text="Provider profile IDs (comma separated)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MatrixProvidersText" Text="" Style="{StaticResource FormTextBox}" MaxLength="512"
                                                 TextChanged="MatrixConfiguration_TextChanged"
                                                 AutomationProperties.HelpText="Filled from safe identities derived from active-session provider configs; credentials remain in process memory." />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}">
                                        <TextBlock Text="Executable dimension" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="MatrixDimensionParameterPicker" Style="{DynamicResource Arena.ComboBox}" SelectedIndex="1"
                                                  SelectionChanged="MatrixConfiguration_SelectionChanged">
                                            <ComboBoxItem Content="None (provider-only comparison)" Tag="" />
                                            <ComboBoxItem Content="Temperature" Tag="temperature" />
                                            <ComboBoxItem Content="Max output tokens" Tag="max_output_tokens" />
                                            <ComboBoxItem Content="Context length" Tag="context_length" />
                                            <ComboBoxItem Content="Reasoning" Tag="reasoning" />
                                            <ComboBoxItem Content="Timeout seconds" Tag="timeout_seconds" />
                                        </ComboBox>
                                        <TextBlock Text="Dimension values (comma separated)" Style="{StaticResource FieldLabel}" Margin="{DynamicResource Arena.Layout.FieldLabelMargin}" />
                                        <TextBox x:Name="MatrixDimensionValuesText" Text="0.2,0.7" Style="{StaticResource FormTextBox}" MaxLength="1024"
                                                 TextChanged="MatrixConfiguration_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}">
                                        <TextBlock Text="Benchmark pack (optional)" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="MatrixBenchmarkPicker" Style="{DynamicResource Arena.ComboBox}"
                                                  SelectionChanged="MatrixBenchmarkPicker_SelectionChanged"
                                                  AutomationProperties.Name="Optional benchmark pack"
                                                  AutomationProperties.HelpText="Select a canonical benchmark pack or keep the run scenario-only. Required rubric identities are carried into strict Core resolution." />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}">
                                        <TextBlock Text="Rubric IDs (comma separated)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MatrixRubricsText" Text="" Style="{StaticResource FormTextBox}" MaxLength="1024"
                                                 TextChanged="MatrixConfiguration_TextChanged"
                                                 AutomationProperties.Name="Experiment rubric identities"
                                                 AutomationProperties.HelpText="A scenario-only experiment still requires at least one versioned rubric identity. Benchmark selection fills its required rubric identities automatically." />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}">
                                        <WrapPanel>
                                            <StackPanel Width="132" Margin="{DynamicResource Arena.Gap.Inline.After.Default}">
                                                <TextBlock Text="Repetitions (1-100)" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="MatrixRepetitionsText" Text="1" Style="{StaticResource FormTextBox}" MaxLength="3"
                                                         TextChanged="MatrixConfiguration_TextChanged" />
                                            </StackPanel>
                                            <StackPanel Width="132" Margin="{DynamicResource Arena.Gap.Inline.After.Default}">
                                                <TextBlock Text="Turn budget (1-100)" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="MatrixTurnBudgetText" Text="4" Style="{StaticResource FormTextBox}" MaxLength="3"
                                                         TextChanged="MatrixConfiguration_TextChanged" />
                                            </StackPanel>
                                            <StackPanel Width="150">
                                                <TextBlock Text="Parallelism (1-32)" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="MatrixParallelismText" Text="1" Style="{StaticResource FormTextBox}" MaxLength="2"
                                                         TextChanged="MatrixConfiguration_TextChanged" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="MatrixValidateStage" Style="{StaticResource ExperimentStageCard}"
                                AutomationProperties.Name="Matrix stage 2 Validate"
                                AutomationProperties.HelpText="Persist and validate the draft, resolve prerequisites, and inspect the deterministic expansion."
                                AutomationProperties.ItemStatus="needs-validation">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource ExperimentStatusChip}"
                                            Background="{DynamicResource NavActiveBrush}"
                                            BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                            Margin="{DynamicResource Arena.Gap.Inline.After.Default}">
                                        <TextBlock Text="2" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource ExperimentStatusChip}">
                                        <TextBlock x:Name="MatrixValidationStageStatusText" Text="Needs validation"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource Arena.Type.MicroSize}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Validate" Style="{StaticResource ExperimentSectionTitle}" Margin="{DynamicResource Arena.Inset.None}" />
                                        <TextBlock Text="Validation persists the exact draft and resolves packs, rubrics, session setup, and process-memory provider profiles."
                                                   Style="{StaticResource HintText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <Button x:Name="ValidateMatrixButton" Content="Validate &amp; expand" Click="ValidateMatrixButton_Click"
                                        Style="{DynamicResource Arena.Button.Primary}" MinWidth="150" HorizontalAlignment="Left"
                                        Margin="{DynamicResource Arena.Gap.Stack.Before.Section}"
                                        AutomationProperties.Name="Validate and expand experiment matrix" />
                                <TextBlock x:Name="MatrixStatusText" Text="Draft not validated."
                                           Style="{StaticResource HintText}" Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <DockPanel Margin="{DynamicResource Arena.Layout.SectionHeadingMargin}" LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource ExperimentStatusChip}">
                                        <TextBlock x:Name="MatrixPreviewStateText" Text="Empty"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource Arena.Type.MicroSize}" />
                                    </Border>
                                    <TextBlock Text="Expansion preview" Style="{StaticResource ExperimentSectionTitle}" Margin="{DynamicResource Arena.Inset.None}" />
                                </DockPanel>
                                <Border x:Name="MatrixPreviewEmptyState" Style="{StaticResource ExperimentEmptyState}"
                                        AutomationProperties.Name="Experiment expansion empty state">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="No expansion yet" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                        <TextBlock x:Name="MatrixPreviewEmptyText"
                                                   Text="Validate the current configuration to generate a bounded expansion preview."
                                                   Style="{StaticResource HintText}" TextWrapping="Wrap"
                                                   Margin="{DynamicResource Arena.Gap.Stack.Before.Tight}" />
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="MatrixPreviewItems" Style="{DynamicResource Arena.ListBox}" MinHeight="80" MaxHeight="210"
                                         Visibility="Collapsed"
                                         Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource DisabledBorderBrush}"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="Experiment expansion cells" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="MatrixRunStage" Style="{StaticResource ExperimentStageCard}"
                                AutomationProperties.Name="Matrix stage 3 Run"
                                AutomationProperties.HelpText="Run only the resolved matrix; cancellation and explicit retry preserve durable cell evidence."
                                AutomationProperties.ItemStatus="blocked">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource ExperimentStatusChip}"
                                            Background="{DynamicResource NavActiveBrush}"
                                            BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                            Margin="{DynamicResource Arena.Gap.Inline.After.Default}">
                                        <TextBlock Text="3" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource ExperimentStatusChip}">
                                        <TextBlock x:Name="MatrixRunStageStatusText" Text="Blocked"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource Arena.Type.MicroSize}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Run" Style="{StaticResource ExperimentSectionTitle}" Margin="{DynamicResource Arena.Inset.None}" />
                                        <TextBlock Text="Run remains blocked until validation resolves every prerequisite. Retry approval is consumed by one Run only."
                                                   Style="{StaticResource HintText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <CheckBox x:Name="MatrixRetryApprovedCheckBox"
                                          Style="{DynamicResource Arena.CheckBox.Standard}"
                                          Content="Rerun every terminal cell once (explicit approval)"
                                          Margin="{DynamicResource Arena.Gap.Stack.Before.Section}"
                                          AutomationProperties.Name="Approve one retry of every terminal experiment cell"
                                          AutomationProperties.HelpText="Consumed by the next Run only. Each retried cell gets a new attempt, trial identity, and isolated child; prior evidence remains durable." />
                                <WrapPanel Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}">
                                    <Button x:Name="ExecuteMatrixButton" Content="Run matrix" IsEnabled="False" Click="ExecuteMatrixButton_Click"
                                            Style="{DynamicResource Arena.Button.Primary}" MinWidth="110"
                                            ToolTip="Validate the matrix to resolve execution availability."
                                            AutomationProperties.Name="Run experiment matrix"
                                            AutomationProperties.HelpText="Runs the resolved matrix through isolated child sessions and the configured provider, then persists content-free evidence." />
                                    <Button x:Name="CancelMatrixButton" Content="Cancel" IsEnabled="False" Click="CancelMatrixButton_Click"
                                            Style="{DynamicResource Arena.Button.Secondary}" MinWidth="90" Margin="{DynamicResource Arena.Gap.Inline.Before.Default}"
                                            AutomationProperties.Name="Cancel experiment matrix"
                                            AutomationProperties.HelpText="Requests cancellation of the active matrix run; completed cell evidence remains durable." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="MatrixReviewStage" Style="{StaticResource ExperimentStageCard}"
                                AutomationProperties.Name="Matrix stage 4 Review"
                                AutomationProperties.HelpText="Inspect bounded persisted run receipts without exposing prompts or provider credentials.">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource ExperimentStatusChip}"
                                            Background="{DynamicResource NavActiveBrush}"
                                            BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                            Margin="{DynamicResource Arena.Gap.Inline.After.Default}">
                                        <TextBlock Text="4" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource ExperimentStatusChip}">
                                        <TextBlock x:Name="RunHistoryStateText" Text="Empty"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource Arena.Type.MicroSize}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Review" Style="{StaticResource ExperimentSectionTitle}" Margin="{DynamicResource Arena.Inset.None}" />
                                        <TextBlock Text="Review expansion outcomes and durable run history. Empty, loading, and failed states remain distinct."
                                                   Style="{StaticResource HintText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <Button x:Name="RefreshRunHistoryButton" Content="Refresh history" Click="RefreshRunHistoryButton_Click"
                                        Style="{DynamicResource Arena.Button.Secondary}" MinWidth="120" HorizontalAlignment="Left"
                                        Margin="{DynamicResource Arena.Gap.Stack.Before.Section}"
                                        AutomationProperties.Name="Refresh persisted experiment run history" />
                                <Border x:Name="RunHistoryEmptyState" Style="{StaticResource ExperimentEmptyState}"
                                        Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}"
                                        AutomationProperties.Name="Experiment run history empty state">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="No run history" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                        <TextBlock x:Name="RunHistoryEmptyText" Text="No persisted experiment runs are available yet."
                                                   Style="{StaticResource HintText}" TextWrapping="Wrap"
                                                   Margin="{DynamicResource Arena.Gap.Stack.Before.Tight}" />
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="RunHistoryItems" Style="{DynamicResource Arena.ListBox}" MinHeight="60" MaxHeight="180"
                                         Visibility="Collapsed" Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}"
                                         Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource DisabledBorderBrush}"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="Persisted experiment run history" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="ForkPanel" Visibility="Collapsed" AutomationProperties.Name="Conversation Fork Lab">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="{DynamicResource Arena.Layout.FeatureSectionMargin}">
                    <TextBlock Text="Conversation Fork Lab" Style="{StaticResource ExperimentTitle}" />
                    <TextBlock Text="Branch the transcript and provenance-bearing memory at one stable cursor. Future turns and unproven memory are omitted; legacy sessions retain the current setup because cursor-scoped setup history is unavailable."
                               Style="{StaticResource HintText}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource ExperimentCard}">
                            <StackPanel>
                                <TextBlock Text="Historical cursor" Style="{StaticResource ExperimentSectionTitle}" />
                                <TextBlock Text="Current session" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="ForkSessionText" Text="No session loaded." Foreground="{DynamicResource TextBrush}" Margin="{DynamicResource Arena.Gap.Stack.After.Default}" />
                                <TextBlock Text="Transcript cursor" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ForkCursorPicker" Style="{DynamicResource Arena.ComboBox}"
                                          DisplayMemberPath="DisplayText" AutomationProperties.Name="Historical transcript cursor" />
                                <TextBlock Text="Optional child session ID" Style="{StaticResource FieldLabel}" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}" />
                                <TextBox x:Name="ForkTargetText" Style="{StaticResource FormTextBox}" MaxLength="96"
                                         ToolTip="Leave empty for a deterministic collision-safe child name." />
                                <WrapPanel Margin="{DynamicResource Arena.Gap.Stack.Before.Section}">
                                    <Button Content="Refresh cursors" Click="RefreshForkCursorsButton_Click" Style="{DynamicResource Arena.Button.Secondary}"
                                            MinWidth="120" Margin="{DynamicResource Arena.Gap.Inline.After.Default}" AutomationProperties.Name="Refresh conversation fork cursors" />
                                    <Button x:Name="CreateForkButton" Content="Fork &amp; load child" Click="CreateForkButton_Click" Style="{DynamicResource Arena.Button.Primary}"
                                            MinWidth="150" AutomationProperties.Name="Create historical conversation fork and load it" />
                                </WrapPanel>
                                <TextBlock x:Name="ForkStatusText" Text="Select a stable transcript cursor."
                                           Style="{StaticResource HintText}" Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="PacksPanel" Visibility="Collapsed" AutomationProperties.Name="Scenario and Benchmark Packs">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="{DynamicResource Arena.Layout.FeatureSectionMargin}">
                    <TextBlock Text="Scenario &amp; Benchmark Packs" Style="{StaticResource ExperimentTitle}" />
                    <TextBlock Text="Create, import, export, and list canonical local packs. Invalid schemas, non-canonical JSON, duplicates, and unsafe content are diagnosed."
                               Style="{StaticResource HintText}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource ExperimentCard}">
                            <StackPanel>
                                <TextBlock Text="Create versioned pack" Style="{StaticResource ExperimentSectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Pack name" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="PackNameText" Text="Local smoke pack" Style="{StaticResource FormTextBox}" MaxLength="120" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Version" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="PackVersionText" Text="1.0.0" Style="{StaticResource FormTextBox}" MaxLength="32" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Scenario turn budget (1-100)" Style="{StaticResource FieldLabel}" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}" />
                                <TextBox x:Name="PackTurnBudgetText" Text="4" Style="{StaticResource FormTextBox}" Width="120" HorizontalAlignment="Left" MaxLength="3" />
                                <WrapPanel Margin="{DynamicResource Arena.Gap.Stack.Before.Section}">
                                    <Button Content="Save scenario pack" Click="SaveScenarioPackButton_Click" Style="{DynamicResource Arena.Button.Primary}"
                                            MinWidth="145" Margin="{DynamicResource Arena.Gap.Inline.After.Default}" AutomationProperties.Name="Create and save canonical scenario pack" />
                                    <Button Content="Save benchmark pack" Click="SaveBenchmarkPackButton_Click" Style="{DynamicResource Arena.Button.Secondary}"
                                            MinWidth="155" AutomationProperties.Name="Create and save canonical benchmark pack" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ExperimentCard}">
                            <StackPanel>
                                <TextBlock Text="Portable pack store" Style="{StaticResource ExperimentSectionTitle}" />
                                <WrapPanel>
                                    <Button Content="Import canonical JSON" Click="ImportPackButton_Click" Style="{DynamicResource Arena.Button.Secondary}"
                                            MinWidth="150" Margin="{DynamicResource Arena.Gap.Inline.After.Default}" AutomationProperties.Name="Import canonical scenario or benchmark pack" />
                                    <Button x:Name="ExportPackButton" Content="Export selected" Click="ExportPackButton_Click" Style="{DynamicResource Arena.Button.Secondary}"
                                            MinWidth="120" Margin="{DynamicResource Arena.Gap.Inline.After.Default}" AutomationProperties.Name="Export selected canonical pack" />
                                    <Button Content="Refresh" Click="RefreshPacksButton_Click" Style="{DynamicResource Arena.Button.Secondary}"
                                            MinWidth="80" AutomationProperties.Name="Refresh scenario and benchmark packs" />
                                </WrapPanel>
                                <ListBox x:Name="PackItems" Style="{DynamicResource Arena.ListBox}" MinHeight="130" MaxHeight="260" Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}"
                                         Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource DisabledBorderBrush}" DisplayMemberPath="DisplayText"
                                         AutomationProperties.Name="Stored scenario and benchmark packs" />
                                <TextBlock x:Name="PackStatusText" Text="No pack action yet."
                                           Style="{StaticResource HintText}" Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="RubricPanel" Visibility="Collapsed" AutomationProperties.Name="Rubric and Judge Studio">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="{DynamicResource Arena.Layout.FeatureSectionMargin}">
                    <TextBlock Text="Rubric &amp; Judge Studio" Style="{StaticResource ExperimentTitle}" />
                    <TextBlock Text="Version weighted rubrics and retain human, deterministic, model-judge, and unavailable observations as separate evidence."
                               Style="{StaticResource HintText}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource ExperimentCard}">
                            <StackPanel>
                                <TextBlock Text="Rubric definition" Style="{StaticResource ExperimentSectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="RubricNameText" Text="Response quality" Style="{StaticResource FormTextBox}" MaxLength="120" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Version" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="RubricVersionText" Text="1.0.0" Style="{StaticResource FormTextBox}" MaxLength="32" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Criterion" Style="{StaticResource FieldLabel}" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}" />
                                <TextBox x:Name="RubricCriterionText" Text="Grounded quality" Style="{StaticResource FormTextBox}" MaxLength="120" />
                                <Button x:Name="SaveRubricButton" Content="Save rubric version" Click="SaveRubricButton_Click" Style="{DynamicResource Arena.Button.Primary}"
                                        MinWidth="140" HorizontalAlignment="Left" Margin="{DynamicResource Arena.Gap.Stack.Before.Section}"
                                        AutomationProperties.Name="Save versioned evaluation rubric" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ExperimentCard}">
                            <StackPanel>
                                <TextBlock Text="Record observation" Style="{StaticResource ExperimentSectionTitle}" />
                                <TextBlock Text="Rubric" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="RubricPicker" Style="{DynamicResource Arena.ComboBox}" DisplayMemberPath="DisplayText"
                                          AutomationProperties.Name="Stored rubric version" />
                                <Grid Margin="{DynamicResource Arena.Gap.Stack.Before.Default}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Evidence source" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="RubricSourcePicker" Style="{DynamicResource Arena.ComboBox}" SelectedIndex="0">
                                            <ComboBoxItem Content="Human" Tag="human" />
                                            <ComboBoxItem Content="Deterministic (diagnostic evidence required)" Tag="deterministic" />
                                            <ComboBoxItem Content="Model judge (inferred)" Tag="model" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Score (0-5)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="RubricScoreText" Text="3" Style="{StaticResource FormTextBox}" MaxLength="4" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="SubjectAIdentityPanel">
                                    <TextBlock Text="Subject A stable reference" Style="{StaticResource FieldLabel}" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}" />
                                    <TextBox x:Name="RubricSubjectAText" Text="subject:current" Style="{StaticResource FormTextBox}" MaxLength="160" />
                                </StackPanel>
                                <CheckBox x:Name="RubricUnavailableCheckBox" Content="Evidence unavailable (store no numeric score)"
                                          Style="{DynamicResource Arena.CheckBox.Standard}"
                                          Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}"
                                          AutomationProperties.Name="Record unavailable rubric evidence" />
                                <CheckBox x:Name="RubricPairwiseCheckBox" Content="Blind pairwise comparison"
                                          Style="{DynamicResource Arena.CheckBox.Standard}"
                                          Margin="{DynamicResource Arena.Gap.Stack.Before.Compact}"
                                          Checked="RubricPairwiseCheckBox_Changed" Unchecked="RubricPairwiseCheckBox_Changed"
                                          ToolTip="First persist a concealed A/B commitment, then submit scores and preference against opaque labels."
                                          AutomationProperties.Name="Use two-step blind pairwise comparison"
                                          AutomationProperties.HelpText="Begin persists the concealed mapping before judgment. Submit persists a receipt and result before revealing identities." />
                                <StackPanel x:Name="PairwiseFields" Visibility="Collapsed" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}">
                                    <StackPanel x:Name="SubjectBIdentityPanel">
                                        <TextBlock Text="Subject B stable reference" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="RubricSubjectBText" Text="subject:candidate" Style="{StaticResource FormTextBox}" MaxLength="160" />
                                    </StackPanel>
                                    <Border x:Name="BlindJudgeView" Visibility="Collapsed" Margin="{DynamicResource Arena.Layout.InsetSectionMargin}" Padding="{DynamicResource Arena.Inset.Card}"
                                            Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="{DynamicResource Arena.Radius.Small}">
                                        <StackPanel>
                                            <TextBlock Text="Concealed judge view" Style="{StaticResource FieldLabel}" />
                                            <TextBlock x:Name="BlindJudgeViewText" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                                       AutomationProperties.Name="Opaque blind comparison labels" />
                                            <TextBlock Text="Score only the opaque A/B labels below. Original identities remain hidden until the committed result is saved."
                                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="{DynamicResource Arena.Gap.Stack.Before.Tight}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Subject B score (0-5)" Style="{StaticResource FieldLabel}" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}" />
                                    <TextBox x:Name="RubricScoreBText" Text="3" Style="{StaticResource FormTextBox}" MaxLength="4" />
                                    <TextBlock Text="Blind preference" Style="{StaticResource FieldLabel}" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}" />
                                    <ComboBox x:Name="RubricPreferencePicker" Style="{DynamicResource Arena.ComboBox}" SelectedIndex="0">
                                        <ComboBoxItem Content="A" Tag="A" />
                                        <ComboBoxItem Content="B" Tag="B" />
                                        <ComboBoxItem Content="Tie" Tag="Tie" />
                                        <ComboBoxItem Content="Unavailable" Tag="Unavailable" />
                                    </ComboBox>
                                    <WrapPanel Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}">
                                        <Button x:Name="BeginBlindPairwiseButton" Content="Begin concealed comparison"
                                                Click="BeginBlindPairwiseButton_Click" Style="{DynamicResource Arena.Button.Secondary}"
                                                MinWidth="180" Margin="{DynamicResource Arena.Gap.Inline.After.Default}"
                                                AutomationProperties.Name="Persist blind comparison commitment" />
                                        <Button x:Name="SubmitBlindPairwiseButton" Content="Submit blind judgment"
                                                Click="SubmitBlindPairwiseButton_Click" Style="{DynamicResource Arena.Button.Primary}"
                                                MinWidth="160" Margin="{DynamicResource Arena.Gap.Inline.After.Default}" IsEnabled="False"
                                                AutomationProperties.Name="Persist blind judgment receipt and result" />
                                        <Button x:Name="CancelBlindPairwiseButton" Content="Cancel concealed view"
                                                Click="CancelBlindPairwiseButton_Click" Style="{DynamicResource Arena.Button.Secondary}"
                                                MinWidth="145" IsEnabled="False"
                                                AutomationProperties.Name="Cancel pending blind comparison" />
                                    </WrapPanel>
                                </StackPanel>
                                <WrapPanel Margin="{DynamicResource Arena.Gap.Stack.Before.Section}">
                                    <Button x:Name="RecordRubricObservationButton" Content="Record observation" Click="RecordRubricObservationButton_Click" Style="{DynamicResource Arena.Button.Primary}"
                                            MinWidth="145" Margin="{DynamicResource Arena.Gap.Inline.After.Default}" AutomationProperties.Name="Record separated rubric observation" />
                                    <Button x:Name="RunProviderJudgeButton" Content="Run provider judge" Click="RunProviderJudgeButton_Click" Style="{DynamicResource Arena.Button.Secondary}"
                                            MinWidth="145" Margin="{DynamicResource Arena.Gap.Inline.After.Default}" AutomationProperties.Name="Run provider-backed model judge"
                                            AutomationProperties.HelpText="Invokes the judged message speaker's effective configured provider route, parses strict rubric JSON, and persists a request-bound receipt before the inferred model score." />
                                    <Button x:Name="CancelProviderJudgeButton" Content="Cancel judge" Click="CancelProviderJudgeButton_Click" Style="{DynamicResource Arena.Button.Secondary}"
                                            MinWidth="105" Margin="{DynamicResource Arena.Gap.Inline.After.Default}" Visibility="Collapsed"
                                            AutomationProperties.Name="Cancel active provider judge"
                                            AutomationProperties.HelpText="Cancels the active provider request. No receipt or result is saved unless provider completion already yielded a finalization." />
                                    <Button x:Name="RefreshRubricsButton" Content="Refresh" Click="RefreshRubricsButton_Click" Style="{DynamicResource Arena.Button.Secondary}"
                                            MinWidth="80" AutomationProperties.Name="Refresh rubric definitions and results" />
                                </WrapPanel>
                                <TextBlock x:Name="RubricStatusText" Text="Create or select a rubric version."
                                           Style="{StaticResource HintText}" Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <ListBox x:Name="RubricResultItems" Style="{DynamicResource Arena.ListBox}" MinHeight="70" MaxHeight="160" Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}"
                                         Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource DisabledBorderBrush}" AutomationProperties.Name="Separated rubric results" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="ClaimPanel" Visibility="Collapsed" AutomationProperties.Name="Evidence and Claim Ledger">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="{DynamicResource Arena.Layout.FeatureSectionMargin}">
                    <TextBlock Text="Evidence &amp; Claim Ledger" Style="{StaticResource ExperimentTitle}" />
                    <TextBlock Text="Link bounded claim summaries to stable message references, observed evidence, reviewer decisions, and monotonic contradiction history."
                               Style="{StaticResource HintText}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer x:Name="ClaimScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Claim Ledger workspace">
                    <Grid x:Name="ClaimWorkspaceGrid"
                          KeyboardNavigation.TabNavigation="Continue">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ClaimMasterColumn" Width="260" />
                            <ColumnDefinition x:Name="ClaimWideGapColumn" Width="12" />
                            <ColumnDefinition x:Name="ClaimDetailColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ClaimMasterRow" Height="Auto" />
                            <RowDefinition x:Name="ClaimCompactGapRow" Height="0" />
                            <RowDefinition x:Name="ClaimDetailRow" Height="0" />
                        </Grid.RowDefinitions>

                        <Border x:Name="ClaimMasterPane"
                                Style="{StaticResource ExperimentCard}"
                                AutomationProperties.Name="Claim Ledger master controls"
                                AutomationProperties.HelpText="Create, refresh, and select the monotonic ledger whose claims are shown in the detail pane.">
                            <StackPanel>
                                <TextBlock Text="Ledger" Style="{StaticResource ExperimentSectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Experiment ID" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ClaimExperimentText" Text="experiment:local" Style="{StaticResource FormTextBox}" MaxLength="160" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Branch ID" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ClaimBranchText" Text="branch:current" Style="{StaticResource FormTextBox}" MaxLength="160" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="{DynamicResource Arena.Gap.Stack.Before.Section}">
                                    <Button Content="Create ledger" Click="CreateClaimLedgerButton_Click" Style="{DynamicResource Arena.Button.Secondary}"
                                            MinWidth="110" Margin="{DynamicResource Arena.Gap.Inline.After.Default}" AutomationProperties.Name="Create monotonic claim ledger" />
                                    <Button Content="Refresh" Click="RefreshClaimsButton_Click" Style="{DynamicResource Arena.Button.Secondary}"
                                            MinWidth="80" AutomationProperties.Name="Refresh claim ledgers" />
                                </WrapPanel>
                                <TextBlock Text="Stored ledger" Style="{StaticResource FieldLabel}" Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}" />
                                <ComboBox x:Name="ClaimLedgerPicker" Style="{DynamicResource Arena.ComboBox}" DisplayMemberPath="DisplayText"
                                           SelectionChanged="ClaimLedgerPicker_SelectionChanged" AutomationProperties.Name="Stored claim ledger" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ClaimDetailPane"
                                Grid.Column="2"
                                Style="{StaticResource ExperimentCard}"
                                AutomationProperties.Name="Claim Ledger detail controls"
                                AutomationProperties.HelpText="Add and review claims in the selected ledger, or link exactly two selected claims as contradictory.">
                            <StackPanel>
                                <TextBlock Text="Add or review claim" Style="{StaticResource ExperimentSectionTitle}" />
                                <TextBlock Text="Stable transcript message" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ClaimMessagePicker" Style="{DynamicResource Arena.ComboBox}" DisplayMemberPath="DisplayText"
                                          AutomationProperties.Name="Claim transcript message reference" />
                                <TextBlock Text="Bounded claim summary" Style="{StaticResource FieldLabel}" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}" />
                                <TextBox x:Name="ClaimSummaryText" Style="{StaticResource FormTextBox}" MaxLength="1024"
                                         AutomationProperties.Name="Claim summary" />
                                <WrapPanel Margin="{DynamicResource Arena.Gap.Stack.Before.Section}">
                                    <Button Content="Add claim" Click="AddClaimButton_Click" Style="{DynamicResource Arena.Button.Primary}"
                                            MinWidth="100" Margin="{DynamicResource Arena.Gap.Inline.After.Default}" AutomationProperties.Name="Add claim with stable message evidence" />
                                    <Button Content="Mark supported" Click="ReviewClaimButton_Click" Tag="supported" Style="{DynamicResource Arena.Button.Secondary}"
                                            MinWidth="120" Margin="{DynamicResource Arena.Gap.Inline.After.Default}" AutomationProperties.Name="Review selected claim as supported" />
                                    <Button Content="Mark unavailable" Click="ReviewClaimButton_Click" Tag="unavailable" Style="{DynamicResource Arena.Button.Secondary}"
                                            MinWidth="130" AutomationProperties.Name="Review selected claim as unavailable" />
                                </WrapPanel>
                                <TextBlock Text="Claims (select two for contradiction)" Style="{StaticResource FieldLabel}" Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}" />
                                <ListBox x:Name="ClaimItems" Style="{DynamicResource Arena.ListBox}" SelectionMode="Extended" MinHeight="110" MaxHeight="230"
                                         Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource DisabledBorderBrush}" DisplayMemberPath="DisplayText"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="Claims in selected ledger" />
                                <Button Content="Link selected contradiction" Click="LinkContradictionButton_Click" Style="{DynamicResource Arena.Button.Secondary}"
                                        HorizontalAlignment="Left" MinWidth="170" Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}"
                                        AutomationProperties.Name="Link two selected claims as contradictory" />
                                <TextBlock x:Name="ClaimStatusText" Text="Create or select a ledger."
                                           Style="{StaticResource HintText}" Margin="{DynamicResource Arena.Gap.Stack.Before.Comfortable}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
