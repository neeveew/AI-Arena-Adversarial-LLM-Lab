<UserControl x:Class="AIArena.Wpf.Controls.AgentInspectionLabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AIArena.Wpf.Controls"
             x:Name="InspectionLabRoot"
             MinWidth="320"
             MinHeight="320"
             Focusable="True"
             AutomationProperties.Name="Agent inspection lab"
             AutomationProperties.HelpText="Inspects privacy-redacted provider requests and one explicitly selected agent's structured memory.">
    <UserControl.Resources>
        <Style x:Key="InspectionSectionBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Arena.Radius.Medium}" />
            <Setter Property="Padding" Value="{DynamicResource Arena.Inset.Panel}" />
        </Style>
        <Style x:Key="InspectionCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="{DynamicResource Arena.Type.LabelSize}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="InspectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="{DynamicResource Arena.Type.HeadingSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:WorkspacePageHeaderControl x:Name="InspectionWorkspaceHeader"
                                              Title="Agent Inspection"
                                              Description="Inspect privacy-redacted provider requests and one explicitly selected agent's provenance-aware memory."
                                              PrimaryActionText="Refresh current"
                                              PrimaryActionAutomationName="Refresh current inspection workspace"
                                              PrimaryActionHelpText="Refreshes the selected Context and Prompt or Agent Memory workspace without changing privacy scope."
                                              PrimaryActionRequested="RefreshCurrentWorkspaceHeader_Click" />

        <TabControl Grid.Row="1"
                    x:Name="InspectionTabs"
                    Margin="{DynamicResource Arena.Inset.Panel}"
                    Background="Transparent"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    Foreground="{DynamicResource TextBrush}"
                    FocusVisualStyle="{DynamicResource Arena.FocusVisual}"
                    AutomationProperties.Name="Inspection workspace sections">
            <TabItem x:Name="PromptInspectorTab"
                     Header="Context &amp; Prompt"
                     AutomationProperties.Name="Context and Prompt Inspector">
                <Grid x:Name="PromptFeatureRoot"
                      Margin="{DynamicResource Arena.Inset.Card}"
                      AutomationProperties.Name="Context and Prompt Inspector feature"
                      AutomationProperties.HelpText="Observed provider-boundary evidence with exact body measurements, redacted previews, and explicit unavailable states.">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="PromptHeaderGrid"
                          Margin="{DynamicResource Arena.Gap.Stack.After.Default}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="PromptHeaderActionRow" Height="0" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="PromptHeaderActionColumn" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource InspectionHeading}"
                                       Text="Provider request traces" />
                            <TextBlock Style="{StaticResource InspectionCaption}"
                                       Text="Process-memory only. Hash and byte count describe the exact outbound body; preview content is redacted." />
                        </StackPanel>
                        <WrapPanel x:Name="PromptHeaderActions"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right">
                            <Button x:Name="PromptRefreshButton"
                                    Margin="{DynamicResource Arena.Gap.Inline.Before.Default}"
                                    Style="{DynamicResource Arena.Button.Secondary}"
                                    Content="Refresh"
                                    AutomationProperties.Name="Refresh provider request traces"
                                    AutomationProperties.HelpText="Reloads the bounded in-process trace list."
                                    ToolTip="Refresh provider request traces" />
                            <Button x:Name="PromptClearButton"
                                    Margin="{DynamicResource Arena.Gap.Inline.Before.Compact}"
                                    Style="{DynamicResource Arena.Button.Secondary}"
                                    Content="Clear"
                                    AutomationProperties.Name="Clear provider request traces"
                                     AutomationProperties.HelpText="Clears process-memory traces only. No session data is changed."
                                     ToolTip="Clear process-memory traces" />
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="{DynamicResource Arena.Gap.Stack.After.Default}"
                            Padding="{DynamicResource Arena.Inset.StatusCard}"
                            Background="{DynamicResource InputBrush}"
                            BorderBrush="{DynamicResource DisabledBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Arena.Radius.Small}">
                        <TextBlock x:Name="PromptStatusText"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="No provider requests have been observed in this process."
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="Prompt inspector status" />
                    </Border>

                    <Grid Grid.Row="2" x:Name="PromptWorkspaceGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PromptListColumn" Width="320" />
                            <ColumnDefinition x:Name="PromptDetailColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="PromptPrimaryRow" Height="*" />
                            <RowDefinition x:Name="PromptSecondaryRow" Height="0" />
                        </Grid.RowDefinitions>

                        <Border x:Name="PromptListPane"
                                Margin="{DynamicResource Arena.Gap.Inline.After.Default}"
                                Style="{StaticResource InspectionSectionBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="{DynamicResource Arena.Gap.Stack.After.Default}"
                                           Style="{StaticResource InspectionHeading}"
                                           Text="Request groups" />
                                <ListBox Grid.Row="1"
                                         x:Name="PromptTraceList"
                                         Style="{DynamicResource Arena.ListBox}"
                                         FocusVisualStyle="{DynamicResource Arena.FocusVisual}"
                                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                         AutomationProperties.Name="Provider request traces"
                                         AutomationProperties.HelpText="Requests grouped by correlation identifier. Select a physical attempt to inspect observed evidence.">
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="{DynamicResource Arena.Layout.InspectorDetailMargin}"
                                                               Foreground="{DynamicResource Arena.Brush.Info}"
                                                               FontSize="{DynamicResource Arena.Type.DenseLabelSize}"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name, StringFormat=Correlation: {0}}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ToolTip="{Binding AutomationHelp}"
                                                  AutomationProperties.Name="{Binding AutomationName}"
                                                  AutomationProperties.HelpText="{Binding AutomationHelp}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Text="{Binding Phase}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="{DynamicResource Arena.Gap.Inline.Before.Default}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Text="{Binding AttemptLabel}" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.ColumnSpan="2"
                                                           Margin="{DynamicResource Arena.Gap.Stack.Before.Micro}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Text="{Binding ModelTransport}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="2"
                                                           Grid.ColumnSpan="2"
                                                           Margin="{DynamicResource Arena.Gap.Stack.Before.Micro}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Text="{Binding OutcomeLabel}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border x:Name="PromptDetailPane"
                                Grid.Column="1"
                                Style="{StaticResource InspectionSectionBorder}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource InspectionHeading}"
                                               Text="Observed request evidence" />
                                    <TextBlock x:Name="PromptPrivacyText"
                                               Margin="{DynamicResource Arena.Layout.ActionSectionMargin}"
                                               Style="{StaticResource InspectionCaption}"
                                               Text="Select a request. Credentials, endpoints, paths, URLs, email addresses, and scoped-memory content are unavailable by design." />

                                    <TextBlock Style="{StaticResource InspectionCaption}" Text="REQUEST" />
                                    <TextBlock x:Name="PromptMetadataText"
                                               Margin="{DynamicResource Arena.Layout.FormFieldMargin}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="No request selected."
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Selected request metadata" />

                                    <TextBlock Style="{StaticResource InspectionCaption}" Text="EXACT BODY MEASUREMENT" />
                                    <TextBlock x:Name="PromptHashText"
                                               Margin="{DynamicResource Arena.Layout.FormFieldMargin}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="{DynamicResource Arena.Type.LabelSize}"
                                               Text="Unavailable — no request selected."
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Outbound payload hash and byte count" />

                                    <TextBlock Style="{StaticResource InspectionCaption}" Text="TOKEN EVIDENCE" />
                                    <TextBlock x:Name="PromptTokenText"
                                               Margin="{DynamicResource Arena.Layout.FormFieldMargin}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="Unavailable — no request selected."
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Prompt token evidence" />

                                    <TextBlock Style="{StaticResource InspectionCaption}" Text="REDACTED PAYLOAD PREVIEW" />
                                    <TextBox x:Name="PromptPayloadText"
                                             Margin="{DynamicResource Arena.Layout.CaptionSectionMargin}"
                                             MinHeight="120"
                                             MaxHeight="260"
                                             Padding="{DynamicResource Arena.Inset.Compact}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             Background="{DynamicResource InputBrush}"
                                             BorderBrush="{DynamicResource ControlBorderBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             FontFamily="Cascadia Mono, Consolas"
                                             FontSize="{DynamicResource Arena.Type.LabelSize}"
                                             Text="No redacted preview is available."
                                             FocusVisualStyle="{DynamicResource Arena.FocusVisual}"
                                             AutomationProperties.Name="Redacted outbound payload preview"
                                             AutomationProperties.HelpText="A bounded, redacted rendering of the body whose original exact bytes were measured. This preview is not byte-identical after redaction." />

                                    <TextBlock Style="{StaticResource InspectionCaption}" Text="ROLE TRANSFORMATIONS" />
                                    <ItemsControl x:Name="PromptRolesItems"
                                                  Margin="{DynamicResource Arena.Layout.CaptionSectionMargin}"
                                                  AutomationProperties.Name="Prompt role transformations">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="{DynamicResource Arena.Gap.Stack.After.TightPlus}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Text="{Binding}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource InspectionCaption}" Text="CONTEXT AND OMISSIONS" />
                                    <ItemsControl x:Name="PromptContextItems"
                                                  Margin="{DynamicResource Arena.Gap.Stack.Before.Micro}"
                                                  AutomationProperties.Name="Context evidence and omission explanations">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="{DynamicResource Arena.Gap.Stack.After.TightPlus}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Text="{Binding}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="MemoryDebuggerTab"
                     Header="Memory Debugger"
                     AutomationProperties.Name="Agent Memory Debugger">
                <Grid x:Name="MemoryFeatureRoot"
                      Margin="{DynamicResource Arena.Inset.Card}"
                      AutomationProperties.Name="Agent Memory Debugger feature"
                      AutomationProperties.HelpText="A default-deny, single-agent structured-memory view with provenance-preserving correction and expiry actions.">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="MemoryHeaderGrid"
                          Margin="{DynamicResource Arena.Gap.Stack.After.Default}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="MemoryHeaderActionRow" Height="0" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="MemoryHeaderActionColumn" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource InspectionHeading}" Text="Structured memory" />
                            <TextBlock Style="{StaticResource InspectionCaption}"
                                       Text="Private content stays hidden until one agent is explicitly selected. Corrections and expiry preserve historical evidence." />
                        </StackPanel>
                        <WrapPanel x:Name="MemoryHeaderActions"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right">
                            <Button x:Name="MemoryRefreshButton"
                                    Margin="{DynamicResource Arena.Gap.Inline.Before.Default}"
                                    Style="{DynamicResource Arena.Button.Secondary}"
                                    Content="Refresh"
                                    AutomationProperties.Name="Refresh structured memory"
                                    AutomationProperties.HelpText="Reloads the active session before showing memory evidence."
                                    ToolTip="Refresh structured memory" />
                        </WrapPanel>
                    </Grid>

                    <WrapPanel x:Name="MemoryFilterPanel"
                               Grid.Row="1"
                               Margin="{DynamicResource Arena.Gap.Stack.After.Default}">
                        <StackPanel x:Name="MemoryAgentFilterGroup"
                                    MinWidth="220"
                                    Margin="{DynamicResource Arena.Gap.Inline.After.Spacious}">
                            <TextBlock Margin="{DynamicResource Arena.Gap.Stack.After.Micro}"
                                       Style="{StaticResource InspectionCaption}"
                                       Text="Authorized agent" />
                            <ComboBox x:Name="MemoryAgentPicker"
                                      MinWidth="220"
                                      MinHeight="32"
                                      Style="{DynamicResource Arena.ComboBox}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="AgentId"
                                      FocusVisualStyle="{DynamicResource Arena.FocusVisual}"
                                      AutomationProperties.Name="Authorized memory agent"
                                      AutomationProperties.HelpText="Selecting an agent authorizes this view to display only that agent's private structured memory." />
                        </StackPanel>
                        <StackPanel x:Name="MemoryStateFilterGroup"
                                    MinWidth="150">
                            <TextBlock Margin="{DynamicResource Arena.Gap.Stack.After.Micro}"
                                       Style="{StaticResource InspectionCaption}"
                                       Text="State" />
                            <ComboBox x:Name="MemoryStatePicker"
                                      MinWidth="150"
                                      MinHeight="32"
                                      Style="{DynamicResource Arena.ComboBox}"
                                      SelectedValuePath="Tag"
                                      FocusVisualStyle="{DynamicResource Arena.FocusVisual}"
                                      AutomationProperties.Name="Memory state filter"
                                      AutomationProperties.HelpText="Filters active, expired, superseded, or all memory records.">
                                <ComboBoxItem Content="Active" Tag="active" IsSelected="True" />
                                <ComboBoxItem Content="Expired" Tag="expired" />
                                <ComboBoxItem Content="Superseded" Tag="superseded" />
                                <ComboBoxItem Content="All states" Tag="all" />
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>

                    <Grid Grid.Row="2" x:Name="MemoryWorkspaceGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="MemoryListColumn" Width="380" />
                            <ColumnDefinition x:Name="MemoryDetailColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="MemoryPrimaryRow" Height="*" />
                            <RowDefinition x:Name="MemorySecondaryRow" Height="0" />
                        </Grid.RowDefinitions>

                        <Border x:Name="MemoryListPane"
                                Margin="{DynamicResource Arena.Gap.Inline.After.Default}"
                                Style="{StaticResource InspectionSectionBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="MemoryStatusText"
                                           Margin="{DynamicResource Arena.Gap.Stack.After.Default}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="Select an agent to authorize a scoped private-memory view."
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.Name="Memory debugger status" />
                                <ListBox Grid.Row="1"
                                         x:Name="MemoryEntryList"
                                         Style="{DynamicResource Arena.ListBox}"
                                         FocusVisualStyle="{DynamicResource Arena.FocusVisual}"
                                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                         AutomationProperties.Name="Structured memory entries"
                                         AutomationProperties.HelpText="Bounded entries belonging only to the explicitly selected agent.">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding AutomationHelp}"
                                                        AutomationProperties.Name="{Binding AutomationName}"
                                                        AutomationProperties.HelpText="{Binding AutomationHelp}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               Text="{Binding OriginLabel}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="{DynamicResource Arena.Gap.Inline.Before.Default}"
                                                               Foreground="{DynamicResource Arena.Brush.Info}"
                                                               Text="{Binding StateLabel}" />
                                                </Grid>
                                                <TextBlock Margin="{DynamicResource Arena.Gap.Stack.Before.Tight}"
                                                           MaxHeight="42"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Text="{Binding Text}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="{DynamicResource Arena.Gap.Stack.Before.Tight}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="{DynamicResource Arena.Type.DenseLabelSize}"
                                                           Text="{Binding ScopeLabel}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border x:Name="MemoryDetailPane"
                                Grid.Column="1"
                                Style="{StaticResource InspectionSectionBorder}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource InspectionHeading}" Text="Memory evidence and lifecycle" />
                                    <TextBlock x:Name="MemoryPrivacyText"
                                               Margin="{DynamicResource Arena.Layout.ActionSectionMargin}"
                                               Style="{StaticResource InspectionCaption}"
                                               Text="No agent is authorized in this view. Other-agent private content is not aggregated or previewed." />

                                    <TextBlock Style="{StaticResource InspectionCaption}" Text="SELECTED RECORD" />
                                    <TextBlock x:Name="MemoryMetadataText"
                                               Margin="{DynamicResource Arena.Layout.FormFieldMargin}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="No memory selected."
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Selected memory provenance and lifecycle" />

                                    <TextBlock Style="{StaticResource InspectionCaption}" Text="TEXT" />
                                    <TextBox x:Name="MemoryEditorText"
                                             Margin="{DynamicResource Arena.Layout.CaptionBlockMargin}"
                                             MinHeight="96"
                                             MaxLength="4000"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="{DynamicResource InputBrush}"
                                             BorderBrush="{DynamicResource ControlBorderBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             FocusVisualStyle="{DynamicResource Arena.FocusVisual}"
                                             AutomationProperties.Name="Memory text editor"
                                             AutomationProperties.HelpText="Text for a new manual memory or a correction. Existing records are never overwritten silently." />

                                    <WrapPanel Margin="{DynamicResource Arena.Gap.Stack.After.Default}">
                                        <StackPanel MinWidth="130"
                                                    Margin="{DynamicResource Arena.Gap.Inline.After.Spacious}">
                                            <TextBlock Margin="{DynamicResource Arena.Gap.Stack.After.Micro}"
                                                       Style="{StaticResource InspectionCaption}"
                                                       Text="Visibility" />
                                            <ComboBox x:Name="MemoryVisibilityPicker"
                                                      MinWidth="130"
                                                      MinHeight="32"
                                                      Style="{DynamicResource Arena.ComboBox}"
                                                      SelectedValuePath="Tag"
                                                      FocusVisualStyle="{DynamicResource Arena.FocusVisual}"
                                                      AutomationProperties.Name="New memory visibility">
                                                <ComboBoxItem Content="Private" Tag="private" IsSelected="True" />
                                                <ComboBoxItem Content="Shared" Tag="shared" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel MinWidth="150">
                                            <TextBlock Margin="{DynamicResource Arena.Gap.Stack.After.Micro}"
                                                       Style="{StaticResource InspectionCaption}"
                                                       Text="Expire after" />
                                            <ComboBox x:Name="MemoryExpiryPicker"
                                                      MinWidth="150"
                                                      MinHeight="32"
                                                      Style="{DynamicResource Arena.ComboBox}"
                                                      SelectedValuePath="Tag"
                                                      FocusVisualStyle="{DynamicResource Arena.FocusVisual}"
                                                      AutomationProperties.Name="New memory expiry">
                                                <ComboBoxItem Content="Never" Tag="none" IsSelected="True" />
                                                <ComboBoxItem Content="1 hour" Tag="1" />
                                                <ComboBoxItem Content="24 hours" Tag="24" />
                                                <ComboBoxItem Content="7 days" Tag="168" />
                                            </ComboBox>
                                        </StackPanel>
                                    </WrapPanel>

                                    <WrapPanel HorizontalAlignment="Right">
                                        <Button x:Name="MemoryAddButton"
                                                Margin="{DynamicResource Arena.Gap.Inline.Before.Compact}"
                                                Style="{DynamicResource Arena.Button.Primary}"
                                                Content="Add"
                                                AutomationProperties.Name="Add manual memory"
                                                AutomationProperties.HelpText="Adds an operator-authored record to the selected agent and persists the session." />
                                        <Button x:Name="MemoryCorrectButton"
                                                Margin="{DynamicResource Arena.Gap.Inline.Before.Compact}"
                                                Style="{DynamicResource Arena.Button.Secondary}"
                                                Content="Correct"
                                                AutomationProperties.Name="Correct selected memory"
                                                AutomationProperties.HelpText="Creates a new correction record and retains the selected record as superseded evidence." />
                                        <Button x:Name="MemoryExpireButton"
                                                Margin="{DynamicResource Arena.Gap.Inline.Before.Compact}"
                                                Style="{DynamicResource Arena.Button.Secondary}"
                                                Content="Expire"
                                                AutomationProperties.Name="Expire selected memory"
                                                AutomationProperties.HelpText="Expires the selected current record without deleting its evidence."
                                                ToolTip="Expire selected memory" />
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border x:Name="MemoryBusyOverlay"
                                Grid.RowSpan="2"
                                Grid.ColumnSpan="2"
                                Panel.ZIndex="10"
                                Padding="{DynamicResource Arena.Inset.Panel}"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Arena.Radius.Medium}"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Structured memory revalidation state">
                            <StackPanel MaxWidth="520"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Path Width="24"
                                      Height="24"
                                      HorizontalAlignment="Center"
                                      Data="M 16,4 A 8,8 0 1 0 19,9 M 16,4 L 16,9 M 16,4 L 11,4"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Arena.Brush.Info}"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeThickness="2" />
                                <TextBlock x:Name="MemoryBusyText"
                                           Margin="{DynamicResource Arena.Gap.Stack.Before.Default}"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="Revalidating structured memory…"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.Name="Structured memory progress" />
                                <TextBlock Margin="{DynamicResource Arena.Gap.Stack.Before.Tight}"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource InspectionCaption}"
                                           Text="Editing and lifecycle actions are paused until the active session is revalidated."
                                           TextAlignment="Center" />
                                <Border Width="220"
                                        Height="6"
                                        Margin="{DynamicResource Arena.Gap.Stack.Before.Default}"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource DisabledBorderBrush}"
                                        CornerRadius="{DynamicResource Arena.Radius.Pill}" />
                                <Border Width="160"
                                        Height="6"
                                        Margin="{DynamicResource Arena.Gap.Stack.Before.Tight}"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource DisabledBorderBrush}"
                                        CornerRadius="{DynamicResource Arena.Radius.Pill}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
