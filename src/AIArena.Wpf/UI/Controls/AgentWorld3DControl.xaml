<UserControl x:Class="AIArena.Wpf.Controls.AgentWorld3DControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="420">
    <Grid x:Name="WorldRoot"
          Background="{DynamicResource InputBrush}"
          ClipToBounds="True">
        <Viewport3D x:Name="WorldViewport"
                    ClipToBounds="True"
                    IsHitTestVisible="False" />
        <Canvas x:Name="OverlayCanvas"
                IsHitTestVisible="True" />
        <Grid Margin="16"
              VerticalAlignment="Top"
              IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="WorldHeaderTextPanel"
                        Grid.Column="0"
                        Margin="0,0,12,0">
                <TextBlock Text="AI World"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="WorldStatusText"
                           Text="Waiting for arena snapshot."
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border x:Name="WorldBadge"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    MaxWidth="220"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource PrimaryBorderBrush}"
                    BorderThickness="1"
                    Padding="10,5">
                <TextBlock x:Name="WorldBadgeText"
                           Text="LIVE WORLD"
                           Foreground="{DynamicResource PrimaryBorderBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
        <Border x:Name="WorldControlPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16,52,16,0"
                Background="{DynamicResource OverlayBrush}"
                BorderBrush="{DynamicResource DisabledBorderBrush}"
                BorderThickness="1"
                Padding="8,6">
            <WrapPanel x:Name="WorldControlItems">
                <Button x:Name="FollowCameraButton"
                        Content="FOLLOW"
                        Click="FollowCameraButton_Click"
                        FontSize="10.5"
                        MinHeight="28"
                        Padding="9,3"
                        Margin="{DynamicResource Arena.Gap.Inline.After.Tight}"
                        ToolTip="Camera follows the current speaker" />
                <Button x:Name="FreeCameraButton"
                        Content="FREE"
                        Click="FreeCameraButton_Click"
                        FontSize="10.5"
                        MinHeight="28"
                        Padding="9,3"
                        Margin="{DynamicResource Arena.Gap.Inline.After.Tight}"
                        ToolTip="Camera stays where you move it" />
                <Button x:Name="OverviewCameraButton"
                        Content="OVERVIEW"
                        Click="OverviewCameraButton_Click"
                        FontSize="10.5"
                        MinHeight="28"
                        Padding="9,3"
                        Margin="0,0,10,0"
                        ToolTip="Camera shows the whole world" />
                <CheckBox x:Name="CinematicCameraCheckBox"
                          Content="Cinematic"
                          Checked="CinematicCameraCheckBox_Changed"
                          Unchecked="CinematicCameraCheckBox_Changed"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextBrush}"
                          FontSize="11"
                          ToolTip="Auto-camera adds gentle cinematic motion during AUTO CHAT" />
            </WrapPanel>
        </Border>
        <Border x:Name="WorldCuePanel"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16,76,16,0"
                Background="{DynamicResource OverlayBrush}"
                BorderBrush="{DynamicResource DisabledBorderBrush}"
                BorderThickness="1"
                Padding="8,6">
            <WrapPanel x:Name="WorldCueItems" />
        </Border>
        <Border x:Name="AgentInspectorPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="310"
                Margin="16,96,16,0"
                Background="{DynamicResource OverlayBrush}"
                BorderBrush="{DynamicResource PrimaryBorderBrush}"
                BorderThickness="1"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="InspectorNameText"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="InspectorModelText"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="InspectorCloseButton"
                            Grid.Column="1"
                            Content="X"
                            Click="InspectorCloseButton_Click"
                            ToolTip="Close agent inspector"
                            AutomationProperties.Name="Close agent inspector"
                            AutomationProperties.HelpText="Close the selected agent inspector panel."
                            Width="28"
                            Height="26"
                            MinWidth="28"
                            MinHeight="26"
                            Padding="0"
                            Margin="{DynamicResource Arena.Gap.Inline.Before.Default}"
                            VerticalAlignment="Top" />
                </Grid>
                <WrapPanel x:Name="InspectorEventItems"
                           Grid.Row="1"
                           Margin="{DynamicResource Arena.Gap.Stack.Before.Default}" />
                <TextBlock x:Name="InspectorRoleText"
                           Grid.Row="2"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="{DynamicResource Arena.Gap.Stack.Before.Default}" />
                <TextBlock x:Name="InspectorLastMessageText"
                           Grid.Row="3"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="{DynamicResource Arena.Gap.Stack.Before.Default}" />
                <TextBlock x:Name="InspectorNotesText"
                           Grid.Row="4"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="{DynamicResource Arena.Gap.Stack.Before.Default}" />
            </Grid>
        </Border>
        <Border x:Name="WorldMiniMapPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="16,0,0,92"
                Background="{DynamicResource OverlayBrush}"
                BorderBrush="{DynamicResource DisabledBorderBrush}"
                BorderThickness="1"
                Padding="8">
            <Grid>
                <Canvas x:Name="WorldMiniMapCanvas"
                        Width="168"
                        Height="112"
                        Background="{DynamicResource InputBrush}" />
                <TextBlock Text="MAP"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="5,3,0,0"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>
        <Border x:Name="WorldLegendPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Margin="16"
                Background="{DynamicResource OverlayBrush}"
                BorderBrush="{DynamicResource DisabledBorderBrush}"
                BorderThickness="1"
                Padding="10,8">
            <WrapPanel x:Name="WorldLegendItems" />
        </Border>
        <Border x:Name="EmptyStatePanel"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource DisabledBorderBrush}"
                BorderThickness="1"
                Padding="18,14"
                MaxWidth="360">
            <StackPanel>
                <TextBlock Text="No active agents"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock Text="Load or start a session to populate the world."
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="{DynamicResource Arena.Gap.Stack.Before.Tight}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
