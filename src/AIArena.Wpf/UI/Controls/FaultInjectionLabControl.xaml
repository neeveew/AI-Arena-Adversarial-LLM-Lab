<UserControl x:Class="AIArena.Wpf.Controls.FaultInjectionLabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="FaultLabRoot"
             MinWidth="320"
             MinHeight="320"
             Focusable="True"
             SizeChanged="FaultInjectionLabControl_SizeChanged"
             AutomationProperties.Name="Fault-Injection Lab"
             AutomationProperties.HelpText="Runs bounded deterministic provider faults in process memory and keeps injected cause separate from unavailable recovery evidence.">
    <UserControl.Resources>
        <Style x:Key="FaultLabCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="{DynamicResource Arena.Type.LabelSize}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FaultLabFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FaultLabCaption}">
            <Setter Property="Margin" Value="{DynamicResource Arena.Gap.Stack.After.Tight}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FaultLabCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Arena.Radius.Medium}" />
            <Setter Property="Padding" Value="{DynamicResource Arena.Inset.Panel}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="{DynamicResource Arena.Layout.WorkspaceHeaderMargin}">
            <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="{DynamicResource Arena.Type.PageTitleSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       Text="Fault-Injection Lab" />
            <TextBlock Margin="{DynamicResource Arena.Gap.Stack.Before.Micro}"
                       Style="{StaticResource FaultLabCaption}"
                       Text="Armed profiles are process-only. A provider-boundary observation proves the injected cause, not higher-level recovery." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="{DynamicResource Arena.Layout.WorkspaceStatusMargin}"
                Padding="{DynamicResource Arena.Inset.StatusCard}"
                Background="{DynamicResource InputBrush}"
                BorderBrush="{DynamicResource DisabledBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Arena.Radius.Small}">
            <TextBlock x:Name="FaultStatusText"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Text="Fault injection is unavailable until a provider boundary is connected."
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="38"
                       AutomationProperties.Name="Fault lab status"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Grid Grid.Row="2" x:Name="FaultWorkspaceGrid" Margin="{DynamicResource Arena.Layout.WorkspaceBodyMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FaultSetupColumn" Width="360" />
                <ColumnDefinition x:Name="FaultGapColumn" Width="10" />
                <ColumnDefinition x:Name="FaultEvidenceColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FaultSetupRow" Height="*" />
                <RowDefinition x:Name="FaultCompactGapRow" Height="0" />
                <RowDefinition x:Name="FaultEvidenceRow" Height="0" />
            </Grid.RowDefinitions>

            <Border x:Name="FaultSetupPane" Style="{StaticResource FaultLabCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextBrush}"
                                   FontSize="{DynamicResource Arena.Type.HeadingSize}"
                                   FontWeight="SemiBold"
                                   Text="Deterministic profile" />
                        <TextBlock Margin="{DynamicResource Arena.Layout.WorkspaceDescriptionMargin}"
                                   Style="{StaticResource FaultLabCaption}"
                                   Text="Every value is validated before a decorator is armed. Sequence is zero-based." />

                        <TextBlock Style="{StaticResource FaultLabFieldLabel}" Text="Fault kind" />
                        <ComboBox x:Name="FaultKindPicker"
                                  MinHeight="34"
                                  Margin="{DynamicResource Arena.Gap.Stack.After.DefaultPlus}"
                                  FocusVisualStyle="{DynamicResource Arena.FocusVisual}"
                                  AutomationProperties.Name="Fault kind" />

                        <TextBlock Style="{StaticResource FaultLabFieldLabel}" Text="Seed" />
                        <TextBox x:Name="FaultSeedText"
                                 MinHeight="34"
                                 Margin="{DynamicResource Arena.Gap.Stack.After.DefaultPlus}"
                                 Text="local-fault-seed"
                                 MaxLength="96"
                                 AutomationProperties.Name="Fault schedule seed"
                                 AutomationProperties.HelpText="A bounded deterministic seed retained only while this profile is armed." />

                        <UniformGrid Columns="2" Margin="{DynamicResource Arena.Gap.Stack.After.DefaultPlus}">
                            <StackPanel Margin="{DynamicResource Arena.Gap.Inline.After.Tight}">
                                <TextBlock Style="{StaticResource FaultLabFieldLabel}" Text="Start sequence" />
                                <TextBox x:Name="FaultSequenceText" MinHeight="34" Text="0" MaxLength="7" AutomationProperties.Name="Fault start sequence" />
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource Arena.Gap.Inline.Before.Tight}">
                                <TextBlock Style="{StaticResource FaultLabFieldLabel}" Text="Duration (ms)" />
                                <TextBox x:Name="FaultDurationText" MinHeight="34" Text="250" MaxLength="5" AutomationProperties.Name="Fault duration milliseconds" />
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="{DynamicResource Arena.Gap.Stack.After.DefaultPlus}">
                            <StackPanel Margin="{DynamicResource Arena.Gap.Inline.After.Tight}">
                                <TextBlock Style="{StaticResource FaultLabFieldLabel}" Text="Intensity (%)" />
                                <TextBox x:Name="FaultIntensityText" MinHeight="34" Text="100" MaxLength="3" AutomationProperties.Name="Fault intensity percent" />
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource Arena.Gap.Inline.Before.Tight}">
                                <TextBlock Style="{StaticResource FaultLabFieldLabel}" Text="Max occurrences" />
                                <TextBox x:Name="FaultOccurrencesText" MinHeight="34" Text="1" MaxLength="3" AutomationProperties.Name="Maximum fault occurrences" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Style="{StaticResource FaultLabFieldLabel}" Text="Maximum concurrent provider calls" />
                        <TextBox x:Name="FaultConcurrencyText"
                                 MinHeight="34"
                                 Margin="{DynamicResource Arena.Gap.Stack.After.Section}"
                                 Text="2"
                                 MaxLength="2"
                                 AutomationProperties.Name="Maximum concurrent provider calls" />

                        <WrapPanel HorizontalAlignment="Right">
                            <Button x:Name="ArmFaultButton"
                                    MinHeight="34"
                                    Margin="{DynamicResource Arena.Gap.Wrap.After.Compact}"
                                    Style="{DynamicResource Arena.Button.Primary}"
                                    Content="Arm"
                                    Click="ArmFaultButton_Click"
                                    AutomationProperties.Name="Arm fault profile"
                                    AutomationProperties.HelpText="Validates and arms this process-only provider fault profile." />
                            <Button x:Name="RunFaultProbeButton"
                                    MinHeight="34"
                                    Margin="{DynamicResource Arena.Gap.Wrap.After.Compact}"
                                    Style="{DynamicResource Arena.Button.Secondary}"
                                    Content="Run probe"
                                    IsEnabled="False"
                                    Click="RunFaultProbeButton_Click"
                                    AutomationProperties.Name="Run fault probe"
                                    AutomationProperties.HelpText="Runs one bounded provider request through the armed decorator." />
                            <Button x:Name="DisarmFaultButton"
                                    MinHeight="34"
                                    Margin="{DynamicResource Arena.Gap.Stack.After.Compact}"
                                    Style="{DynamicResource Arena.Button.Secondary}"
                                    Content="Disarm"
                                    IsEnabled="False"
                                    Click="DisarmFaultButton_Click"
                                    AutomationProperties.Name="Disarm fault profile"
                                    AutomationProperties.HelpText="Cancels the current probe, waits for it to unwind, and disarms the provider decorator." />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="FaultEvidencePane"
                    Grid.Column="2"
                    Style="{StaticResource FaultLabCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="{DynamicResource Arena.Gap.Stack.After.Default}">
                        <TextBlock Foreground="{DynamicResource TextBrush}"
                                   FontSize="{DynamicResource Arena.Type.HeadingSize}"
                                   FontWeight="SemiBold"
                                   Text="Cause and recovery evidence" />
                        <TextBlock Margin="{DynamicResource Arena.Gap.Stack.Before.Micro}"
                                   Style="{StaticResource FaultLabCaption}"
                                   Text="Cause is observed at injection. Recovery stays unavailable unless a higher-level runner measures it." />
                    </StackPanel>
                    <ListBox Grid.Row="1"
                             x:Name="FaultObservationList"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource TextBrush}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             FocusVisualStyle="{DynamicResource Arena.FocusVisual}"
                             AutomationProperties.Name="Fault observations"
                             AutomationProperties.HelpText="Bounded content-free observations for the currently armed profile.">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="{DynamicResource Arena.Gap.Stack.After.CompactPlus}"
                                        Padding="{DynamicResource Arena.Inset.ListItem}"
                                        Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource DisabledBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Arena.Radius.Small}">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Heading}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="{DynamicResource Arena.Gap.Stack.Before.Micro}"
                                                   Foreground="{DynamicResource Arena.Brush.Success}"
                                                   Text="{Binding CauseText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="{DynamicResource Arena.Gap.Stack.Before.Nano}"
                                                   Foreground="{DynamicResource Arena.Brush.Warning}"
                                                   Text="{Binding RecoveryText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="{DynamicResource Arena.Inset.None}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding AutomationHelp}" />
                                <Setter Property="FocusVisualStyle" Value="{DynamicResource Arena.FocusVisual}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
