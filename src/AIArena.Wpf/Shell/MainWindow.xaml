                                  ToolTip="Automatically read Narrator turns aloud" />
                        <TextBlock Text="Windows voice" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="VoiceTtsVoicePicker"
                                  SelectionChanged="VoiceTtsVoicePicker_SelectionChanged"
                                  Style="{StaticResource FormComboBox}"
                                  AutomationProperties.Name="Voice TTS voice"
                                  AutomationProperties.HelpText="Choose an installed Windows voice for AI Arena text to speech."
                                  Margin="0,0,0,10"
                                  ToolTip="Choose an installed Windows voice" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rate" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <Slider x:Name="VoiceTtsRateSlider"
                                    Grid.Column="1"
                                    Minimum="-4"
                                    Maximum="4"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="VoiceTtsSlider_Changed"
                                    AutomationProperties.Name="Voice TTS rate"
                                    AutomationProperties.HelpText="Adjust narrator speech speed from slower to faster."
                                    ToolTip="Adjust narrator speech speed" />
                            <TextBlock x:Name="VoiceTtsRateValueText"
                                       Grid.Column="2"
                                       Text="0"
                                       Style="{StaticResource SettingsInlineStatusText}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Volume" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <Slider x:Name="VoiceTtsVolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="VoiceTtsSlider_Changed"
                                    AutomationProperties.Name="Voice TTS volume"
                                    AutomationProperties.HelpText="Adjust narrator speech volume."
                                    ToolTip="Adjust narrator speech volume" />
                            <TextBlock x:Name="VoiceTtsVolumeValueText"
                                       Grid.Column="2"
                                       Text="80%"
                                       Style="{StaticResource SettingsInlineStatusText}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="TestVoiceTtsButton"
                                    Content="Test Voice"
                                    Click="TestVoiceTtsButton_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Test voice TTS"
                                    AutomationProperties.HelpText="Play a short local speech sample with the selected voice settings."
                                    Padding="8"
                                    ToolTip="Play a short local speech sample" />
                            <Button x:Name="StopVoiceTtsButton"
                                    Grid.Column="2"
                                    Content="Stop Voice"
                                    Click="StopVoiceTtsButton_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Stop voice TTS"
                                    AutomationProperties.HelpText="Stop the current text to speech playback."
                                    Padding="8"
                                    ToolTip="Stop current text to speech playback" />
                        </Grid>
                        <TextBlock x:Name="VoiceTtsStatusText"
                                   Text="Local Windows voice playback is off."
                                   Style="{StaticResource HintText}"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="Voice TTS status"
                                   AutomationProperties.HelpText="Reports the current voice text to speech state."
                                   TextWrapping="Wrap"
                                   ToolTip="Voice TTS status" />
                    </StackPanel>
                </Expander>

                <Expander Header="Visuals" Tag="&#xE8A7;" Style="{StaticResource SettingsExpander}" IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Application theme" Style="{StaticResource FieldLabel}" />
