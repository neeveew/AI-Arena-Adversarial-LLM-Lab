                            <ComboBoxItem Content="3s" Tag="3" />
                            <ComboBoxItem Content="5s" Tag="5" />
                        </ComboBox>
                    </StackPanel>
                </Expander>

                <Expander Header="Voice TTS" Tag="&#xE189;" Style="{StaticResource SettingsExpander}" IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                        <CheckBox x:Name="VoiceTtsEnabledCheckBox"
                                  Content="Enable voice playback"
                                  Style="{StaticResource ToggleSwitchCheckBox}"
                                  Foreground="{DynamicResource TextBrush}"
                                  FontWeight="SemiBold"
                                  Checked="VoiceTtsSettings_Changed"
                                  Unchecked="VoiceTtsSettings_Changed"
                                  AutomationProperties.Name="Enable voice TTS"
                                  AutomationProperties.HelpText="Enable local Windows text to speech playback for arena narration."
                                  Margin="0,0,0,6"
                                  ToolTip="Enable local Windows text to speech playback" />
                        <CheckBox x:Name="VoiceTtsAutoNarratorCheckBox"
                                  Content="Auto-read narrator turns"
                                  Style="{StaticResource ToggleSwitchCheckBox}"
                                  Foreground="{DynamicResource TextBrush}"
                                  Checked="VoiceTtsSettings_Changed"
                                  Unchecked="VoiceTtsSettings_Changed"
