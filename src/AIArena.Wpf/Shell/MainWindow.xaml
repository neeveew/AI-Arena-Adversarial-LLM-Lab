        <Style x:Key="WorkflowPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="WorkflowInfoCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <!-- Matches the ShellTopBarControl flyout chrome so all popups share one surface. -->
        <Style x:Key="FlyoutCard" TargetType="Border" BasedOn="{StaticResource Arena.Surface.Panel}">
            <Setter Property="Background" Value="{DynamicResource TopBarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
