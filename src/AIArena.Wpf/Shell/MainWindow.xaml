                                   Style="{StaticResource HintText}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,0,0,8"
                                   Text="Preload telemetry appears here." />
                        <WrapPanel x:Name="PreloadModelsItems"
                                   Margin="0,0,0,8" />
