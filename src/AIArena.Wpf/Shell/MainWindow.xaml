                            MinWidth="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="Close app settings"
                            AutomationProperties.HelpText="Close Settings and return focus to the control that opened it."
                            ToolTip="Close Settings" />
                </Grid>
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsSectionsPanel">
                <Expander x:Name="ModelProviderSettingsExpander"
