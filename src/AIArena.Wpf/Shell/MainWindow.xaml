                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SettingsSearchFeedbackText"
                                       Style="{StaticResource HintText}"
                                       Margin="0"
                                       VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Settings search results" />
                            <Button x:Name="SettingsSearchClearButton"
                                    Grid.Column="1"
                                    Content="Clear"
                                    Click="SettingsSearchClearButton_Click"
                                    Style="{StaticResource CompactButton}"
                                    MinHeight="28"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Clear settings search" />
                        </Grid>
                    </StackPanel>
                    <Button x:Name="CloseAppSettingsButton"
