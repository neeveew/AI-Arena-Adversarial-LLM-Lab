                                HorizontalAlignment="Left"
                                MinWidth="132"
                                Margin="0,0,0,10"
                                AutomationProperties.Name="Test Internet"
                                AutomationProperties.HelpText="Run a real local web search and fetch a safe public HTTPS page. This does not require an active arena session." />
                        <TextBlock x:Name="InternetDiagnosticResultText"
                                   Text="Run Test Internet to verify search, direct page access, and the installed search payload."
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="Internet test result"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Search context is gathered quietly and folded into the same agent reply."
                                   Style="{StaticResource HintText}"
                                   Margin="0,0,0,10" />
                    </StackPanel>
                </Expander>

                <Expander Header="Context Windows" Tag="&#xE8F1;" Style="{StaticResource SettingsExpander}" IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Controls how much recent arena state is sent to model calls."
                                   Style="{StaticResource HintText}"
                                   Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Transcript turns" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ContextTranscriptWindowText"
                                         Style="{StaticResource FormTextBox}"
                                         ToolTip="Recent public transcript messages available to agents and narrator." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Private notes" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ContextPrivateWindowText"
                                         Style="{StaticResource FormTextBox}"
                                         ToolTip="Recent private notes retained per agent." />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Pinned notes" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ContextNotesWindowText"
                                         Style="{StaticResource FormTextBox}"
                                         ToolTip="Pinned or saved note window used by context builders." />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Current summary" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ContextSummaryText"
                                 BorderBrush="{DynamicResource DisabledBorderBrush}"
                                 Style="{StaticResource FormTextBox}"
                                 MinHeight="80"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Expander>

                <Expander Header="Help / About" Tag="&#xE897;" Style="{StaticResource SettingsExpander}" IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="AI Arena"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="AboutVersionText"
                                   Text="Version loading..."
                                   Foreground="{DynamicResource PrimaryBorderBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,10" />
                        <TextBlock Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Native Windows adversarial multi-agent LLM lab for running, steering, observing, and diagnosing conversations between local or OpenAI-compatible language models.&#x0a;&#x0a;Author: Dominik Fiala&#x0a;Code: Codex 5.5&#x0a;&#x0a;Licence: Shareable No-Derivatives Software Licence 1.0&#x0a;Copyright © 2026 Dominik Fiala&#x0a;&#x0a;You may share AI Arena in its original, unmodified form. Modified redistribution requires written permission from the author." />
                        <Button x:Name="OpenReleasesButton"
                                Click="OpenReleasesButton_Click"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,12,0,0"
                                ToolTip="Open the AI Arena GitHub releases page">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE774;" Style="{StaticResource CommandButtonIcon}" />
                                <TextBlock Text="Open GitHub Releases" Style="{StaticResource CommandButtonLabel}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenUserGuideButton"
                                Click="OpenUserGuideButton_Click"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,8,0,0"
                                ToolTip="Open the AI Arena user guide">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE897;" Style="{StaticResource CommandButtonIcon}" />
                                <TextBlock Text="Open User Guide" Style="{StaticResource CommandButtonLabel}" />
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ExportSettingsButton"
                                    Click="ExportSettingsButton_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Export app settings to a JSON file. Conversations and API tokens are not included.">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource CommandButtonIcon}" />
                                    <TextBlock Text="Export Settings" Style="{StaticResource CommandButtonLabel}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ImportSettingsButton"
                                    Grid.Column="2"
                                    Click="ImportSettingsButton_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Import app settings from a previously exported JSON file. Some changes apply after restart.">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8B5;" Style="{StaticResource CommandButtonIcon}" />
                                    <TextBlock Text="Import Settings" Style="{StaticResource CommandButtonLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="SettingsTransferStatusText"
                                   Style="{StaticResource CollapsibleHintText}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,8,0,0"
                                   Text="" />
                    </StackPanel>
                </Expander>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,14,0,0"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Apply saves advanced model-call and context-window edits to this session. Connection, model routing, internet, appearance, Agent, and voice preferences save as you change them."
                                   Style="{StaticResource HintText}"
                                   Margin="0,0,0,4"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SettingsPendingChangesText"
                                   Text="No session-scoped changes pending."
                                   Style="{StaticResource CollapsibleHintText}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap" />
                        <Button x:Name="ApplySettingsButton"
                                Click="ApplySettingsButton_Click"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="False"
                                Margin="0"
                                ToolTip="Apply pending advanced model-call and context-window changes to the current session">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource CommandButtonIcon}" />
                                <TextBlock x:Name="ApplySettingsLabel"
                                           Text="No pending session changes"
                                           Style="{StaticResource CommandButtonLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
