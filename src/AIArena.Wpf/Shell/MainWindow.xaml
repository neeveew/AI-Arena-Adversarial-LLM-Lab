                            <Button x:Name="UnloadSelectedModelsButton"
                                    Grid.Column="2"
                                    Click="UnloadSelectedModelsButton_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Ask the native provider to unload or release the selected default and participant models to free VRAM.">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource CommandButtonIcon}" />
                                    <TextBlock Text="Unload" Style="{StaticResource CommandButtonLabel}" />
