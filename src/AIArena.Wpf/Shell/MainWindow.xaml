                                  Style="{StaticResource FormComboBox}"
                                  SelectionChanged="ThemePicker_SelectionChanged"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  AutomationProperties.Name="Application theme"
                                  AutomationProperties.HelpText="Choose an AI Arena color theme. System automatically follows the Windows high-contrast preference."
                                  ToolTip="Choose an application theme"
                                  Margin="0,0,0,4" />
                        <TextBlock Text="System follows the Windows high-contrast preference. Other themes stay fixed until you change them."
                                   Style="{StaticResource HintText}"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Transcript avatars" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="AvatarStylePicker"
                                  SelectionChanged="VisualSettings_Changed"
                                  Style="{StaticResource FormComboBox}"
                                  Margin="0,0,0,8"
                                  ToolTip="Select one deterministic avatar style for transcript speakers.">
                            <ComboBoxItem Content="Champion portrait pack" Tag="pack" />
                            <ComboBoxItem Content="Procedural robot portraits" Tag="procedural" />
                            <ComboBoxItem Content="Simple robot icons" Tag="simple" />
                            <ComboBoxItem Content="Initials" Tag="initials" />
                        </ComboBox>
                        <TextBlock Text="Stronger robot identities make agents easier to recognize at a glance."
                                   Style="{StaticResource HintText}"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="System event avatar" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="SystemGlyphStylePicker"
                                  SelectionChanged="VisualSettings_Changed"
                                  Style="{StaticResource FormComboBox}"
                                  Margin="0,0,0,8"
                                  ToolTip="Select one rendering style for system, internet, and error events.">
                            <ComboBoxItem Content="Warning / server glyph" Tag="glyph" />
                            <ComboBoxItem Content="Fallback initial" Tag="fallback" />
