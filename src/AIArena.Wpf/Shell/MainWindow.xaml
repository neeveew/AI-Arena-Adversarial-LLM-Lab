                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Download / pull model" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DownloadModelText"
                                         Style="{StaticResource FormTextBox}"
                                         ToolTip="LM Studio model identifier or Ollama tag, for example google/gemma-3-4b or qwen3:8b." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Quantization" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DownloadQuantizationPicker"
                                          Style="{StaticResource FormComboBox}"
                                          ToolTip="Optional LM Studio quantization selector. Auto lets LM Studio choose.">
                                    <ComboBoxItem Content="Auto" Tag="" IsSelected="True" />
                                    <ComboBoxItem Content="Q4_K_M" Tag="Q4_K_M" />
                                    <ComboBoxItem Content="Q5_K_M" Tag="Q5_K_M" />
                                    <ComboBoxItem Content="Q8_0" Tag="Q8_0" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DownloadModelButton"
                                    Click="DownloadModelButton_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Ask LM Studio native API to download the model.">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource CommandButtonIcon}" />
                                    <TextBlock Text="Download" Style="{StaticResource CommandButtonLabel}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CheckDownloadStatusButton"
                                    Grid.Column="2"
                                    Click="CheckDownloadStatusButton_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="False"
                                    ToolTip="Check the latest LM Studio model download job status.">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE895;" Style="{StaticResource CommandButtonIcon}" />
                                    <TextBlock Text="Status" Style="{StaticResource CommandButtonLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="DownloadModelStatusText"
                                   Style="{StaticResource HintText}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,0,0,8"
                                   Text="Downloads use LM Studio native jobs or Ollama native /api/pull." />
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="ProviderAdvancedCallsExpander"
                                  Header="Advanced model calls"
                                  Style="{StaticResource SettingsSubsectionExpander}"
                                  IsExpanded="False">
                            <StackPanel>
                        <TextBlock Text="Shared request defaults for this session. Use Apply at the bottom after editing timeout, temperature, or response limit."
                                   Style="{StaticResource HintText}"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Timeout (seconds)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ProviderTimeoutText"
                                         Style="{StaticResource FormTextBox}"
                                         ToolTip="Whole seconds, 1-3600. How long one model call may run before it is cancelled. Large local models on long prompts can need several minutes." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ProviderTemperatureText"
                                         Style="{StaticResource FormTextBox}"
                                         ToolTip="0-2. Lower is more deterministic; higher is more varied. Out-of-range values are corrected on Apply." />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Response limit (tokens)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ProviderMaxOutputText"
                                         Style="{StaticResource FormTextBox}"
                                         ToolTip="Tokens, 1-32768. Thinking models spend part of this budget on reasoning before public text - keep it generous (4096+) when Reasoning is not Off." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Provider context (tokens)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ProviderContextLengthText"
                                         Style="{StaticResource FormTextBox}"
                                         LostKeyboardFocus="ProviderNativeOptions_Commit"
                                         KeyDown="ProviderNativeOptionsText_KeyDown"
                                         ToolTip="0 uses the provider default. LM Studio native sends context_length; Ollama native sends options.num_ctx." />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Reasoning" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ProviderReasoningPicker"
                                          Style="{StaticResource FormComboBox}"
                                          SelectionChanged="ProviderNativeOptions_SelectionChanged"
                                          ToolTip="For LM Studio native this sends reasoning; for Ollama thinking models this sends think. Auto lets thinking models (Qwen, DeepSeek-R1) think by default - they can spend the whole Max output budget on reasoning and return empty replies. Prefer Off or Low for Agent and Narrator work.">
                                    <ComboBoxItem Content="Auto" Tag="" IsSelected="True" />
                                    <ComboBoxItem Content="Off" Tag="off" />
                                    <ComboBoxItem Content="Low" Tag="low" />
                                    <ComboBoxItem Content="Medium" Tag="medium" />
                                    <ComboBoxItem Content="High" Tag="high" />
                                    <ComboBoxItem Content="On" Tag="on" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unload after idle (seconds)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ProviderNativeIdleTtlText"
                                         Style="{StaticResource FormTextBox}"
                                         LostKeyboardFocus="ProviderNativeOptions_Commit"
                                         KeyDown="ProviderNativeOptionsText_KeyDown"
                                         ToolTip="Seconds before a native provider can unload an idle model. 0 uses provider default." />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="ProviderNativeStatefulChatCheckBox"
                                  Content="Stateful LM Studio chat"
                                  Style="{StaticResource ToggleSwitchCheckBox}"
                                  Foreground="{DynamicResource TextBrush}"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"
                                  IsChecked="True"
                                  Checked="ProviderNativeOptions_CheckedChanged"
                                  Unchecked="ProviderNativeOptions_CheckedChanged"
                                  ToolTip="Use LM Studio native response_id and previous_response_id for continuity across turns." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>

                <Expander x:Name="AgentSettingsExpander" Header="Agent workspace" Tag="&#xE99A;" Style="{StaticResource SettingsExpander}" IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                        <CheckBox x:Name="AgentWorkspaceCheckBox"
                                  Content="Show Agent workspace in navigation"
                                  Style="{StaticResource ToggleSwitchCheckBox}"
                                  Foreground="{DynamicResource TextBrush}"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"
                                  Checked="AgentWorkspaceCheckBox_Changed"
                                  Unchecked="AgentWorkspaceCheckBox_Changed"
                                  AutomationProperties.Name="Toggle Agent workspace navigation"
                                  AutomationProperties.HelpText="Show or hide the Agent workspace in the left navigation. This setting is independent of Debug controls."
                                  ToolTip="Show or hide the Agent workspace in the left navigation" />
                        <CheckBox x:Name="AgentBuilderOnlyDefaultCheckBox"
                                  Content="Builder-only team by default"
                                  Style="{StaticResource ToggleSwitchCheckBox}"
                                  Foreground="{DynamicResource TextBrush}"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"
                                  Checked="AgentSettingsCheckBox_CheckedChanged"
                                  Unchecked="AgentSettingsCheckBox_CheckedChanged"
                                  ToolTip="Start Agent sessions in the faster Builder-only loop instead of the full Planner, Reviewer, and Builder loop. The composer Team button still toggles it per session." />
                        <CheckBox x:Name="StreamModelResponsesCheckBox"
                                  Content="Stream model responses"
                                  Style="{StaticResource ToggleSwitchCheckBox}"
                                  Foreground="{DynamicResource TextBrush}"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"
                                  IsChecked="True"
                                  Checked="StreamModelResponsesCheckBox_CheckedChanged"
                                  Unchecked="StreamModelResponsesCheckBox_CheckedChanged"
                                  ToolTip="Show Agent workspace output while it is generated. Turn this off if a provider misbehaves with streamed responses." />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Planner/Reviewer tokens" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AgentPlannerReviewerTokensText"
                                         Style="{StaticResource FormTextBox}"
                                         LostFocus="AgentSettingsField_Commit"
                                         ToolTip="Output token budget for Planner and Reviewer steps, 256-32768. Thinking models need 4096+ to finish reasoning and still answer." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Builder tokens" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AgentBuilderTokensText"
                                         Style="{StaticResource FormTextBox}"
                                         LostFocus="AgentSettingsField_Commit"
                                         ToolTip="Output token budget for Builder steps, 256-32768. Builder writes full file contents, so keep this the largest." />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Rescue attempts" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AgentRescueAttemptsText"
                                         Style="{StaticResource FormTextBox}"
                                         LostFocus="AgentSettingsField_Commit"
                                         ToolTip="0-5. How many automatic retries the Agent gets when Builder answers prose without a runnable command." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Command timeout (s)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AgentCommandTimeoutText"
                                         Style="{StaticResource FormTextBox}"
                                         LostFocus="AgentSettingsField_Commit"
                                         ToolTip="Seconds, 10-3600, for approved workspace commands. Commands flagged Network/install always get at least 10 minutes." />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Rescue model" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="AgentRescueModelText"
                                 Style="{StaticResource FormTextBox}"
                                 HorizontalContentAlignment="Left"
                                 LostFocus="AgentRescueModelText_LostFocus"
                                 Tag="Optional fallback model..."
                                 Margin="0,0,0,8"
                                 ToolTip="Optional model id used as a fallback when an Agent role step fails or returns no usable text and no other fallback applies." />
                        <Button x:Name="ResetAgentSettingsButton"
                                Click="ResetAgentSettingsButton_Click"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,6"
                                HorizontalAlignment="Left"
                                ToolTip="Restore Agent defaults: full team, 4096/6144 tokens, 2 rescue attempts, 120 s command timeout, no rescue model.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE777;" Style="{StaticResource CommandButtonIcon}" />
                                <TextBlock Text="Reset Agent defaults" Style="{StaticResource CommandButtonLabel}" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="AgentSettingsStatusText"
                                   Style="{StaticResource HintText}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,8,0,0"
                                   Text="Changes apply to the next Agent step; token budgets and timeouts take effect immediately." />
                    </StackPanel>
                </Expander>

                <Expander Header="Auto Chat" Tag="&#xE768;" Style="{StaticResource SettingsExpander}" IsExpanded="False">
