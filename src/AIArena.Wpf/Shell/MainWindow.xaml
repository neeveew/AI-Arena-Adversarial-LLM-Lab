            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SettingsInlineStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="HelpIconButton" TargetType="Button" BasedOn="{StaticResource IconToolbarButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="&#xE713;" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border x:Name="ExpanderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderSite"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="True"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              Padding="10,7">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderChrome"
                                                    Background="Transparent"
                                                    CornerRadius="7"
                                                    MinHeight="38"
                                                    Padding="{TemplateBinding Padding}"
                                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="SectionIconTile"
                                                            Width="25"
                                                            Height="25"
                                                            Background="{DynamicResource InputBrush}"
                                                            BorderBrush="{DynamicResource DisabledBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock x:Name="SectionIcon"
                                                                   Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                   FontFamily="{DynamicResource Arena.Type.IconFontFamily}"
                                                                   FontSize="11"
                                                                   FontWeight="Normal"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock x:Name="HeaderText"
                                                               Grid.Column="1"
                                                               Text="{TemplateBinding Content}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="{TemplateBinding FontWeight}"
                                                               FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="Chevron"
                                                               Grid.Column="2"
                                                               Text="&#xE70D;"
                                                               FontFamily="{DynamicResource Arena.Type.IconFontFamily}"
                                                               FontSize="10.5"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               FontWeight="SemiBold"
                                                               Margin="12,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                                    <Setter TargetName="SectionIconTile" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                                                    <Setter TargetName="SectionIcon" Property="Foreground" Value="{DynamicResource HoverBorderBrush}" />
                                                    <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource HoverBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                                    <Setter TargetName="SectionIconTile" Property="BorderBrush" Value="{DynamicResource Arena.Brush.FocusRing}" />
                                                    <Setter TargetName="SectionIcon" Property="Foreground" Value="{DynamicResource HoverBorderBrush}" />
                                                    <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource HoverBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource InputBrush}" />
                                                    <Setter TargetName="SectionIconTile" Property="Background" Value="{DynamicResource PrimaryBorderBrush}" />
                                                    <Setter TargetName="SectionIconTile" Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
                                                    <Setter TargetName="SectionIcon" Property="Foreground" Value="{DynamicResource InputBrush}" />
                                                    <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                                    <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource PrimaryBorderBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="ContentChrome"
                                        Grid.Row="1"
                                        BorderBrush="{DynamicResource DisabledBorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Margin="10,0,10,10"
                                        Padding="0,10,0,0"
                                        Visibility="Collapsed">
                                    <ContentPresenter ContentSource="Content" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentChrome" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ExpanderBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
                                <Setter TargetName="ExpanderBorder" Property="Background" Value="{DynamicResource PanelBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpanderBorder" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ExpanderBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsSubsectionExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border x:Name="SubsectionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="SubsectionHeader"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="True"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Foreground="{TemplateBinding Foreground}"
                                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderChrome"
                                                    Background="Transparent"
                                                    CornerRadius="6"
                                                    MinHeight="34"
                                                    Padding="9,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                      TextElement.Foreground="{DynamicResource TextBrush}"
                                                                      TextElement.FontSize="12"
                                                                      TextElement.FontWeight="SemiBold"
                                                                      VerticalAlignment="Center" />
                                                    <TextBlock x:Name="Chevron"
                                                               Grid.Column="1"
                                                               Text="&#xE70D;"
                                                               FontFamily="{DynamicResource Arena.Type.IconFontFamily}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               Margin="12,0,2,0"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                                    <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource HoverBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                                    <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource PrimaryBorderBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="SubsectionContent"
                                        Grid.Row="1"
                                        BorderBrush="{DynamicResource DisabledBorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="10"
                                        Visibility="Collapsed">
                                    <ContentPresenter ContentSource="Content" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="SubsectionContent" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SubsectionBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SubsectionBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <!-- Auto + MinHeight lets the bar grow when the session chips wrap instead of
                 clipping them over the content below. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationRailColumn" Width="208" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightRailColumn" Width="320" />
        </Grid.ColumnDefinitions>

        <controls:ShellNavigationRailControl x:Name="ShellNavigationRail"
                                             Grid.RowSpan="2"
                                             ArenaNavigationRequested="ArenaNavButton_Click"
                                             AgentNavigationRequested="AgentNavButton_Click"
                                             MatchSetupNavigationRequested="CustomMatchNavButton_Click"
                                             CollaborateNavigationRequested="CollaborateNavButton_Click"
                                             CollaborateNewChatRequested="CollaborateNewChatButton_Click"
                                             SessionMatchRequested="SessionOverviewMatch_MouseLeftButtonUp"
                                             SessionTurnsRequested="SessionOverviewTurns_MouseLeftButtonUp"
                                             SessionPerformanceRequested="SessionOverviewPerformance_MouseLeftButtonUp"
                                             SessionProviderRequested="SessionOverviewProvider_MouseLeftButtonUp" />

        <controls:ShellTopBarControl x:Name="ShellTopBar"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="2"
                                     InteractionRequested="ShellTopBar_InteractionRequested" />

        <Grid Grid.Row="1" Grid.Column="1" Margin="12,10,10,10">
            <Grid x:Name="TranscriptPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:TranscriptListBox x:Name="TranscriptItems"
                                            Grid.Row="1"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            VirtualizingPanel.IsVirtualizing="True"
                                            VirtualizingPanel.VirtualizationMode="Recycling"
                                            VirtualizingPanel.ScrollUnit="Pixel"
                                            KeyboardNavigation.TabNavigation="Continue">
                    <controls:TranscriptListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </controls:TranscriptListBox.ItemContainerStyle>
                </controls:TranscriptListBox>
                <Grid x:Name="TranscriptDashboardGrid"
                      Grid.Row="0"
                      Margin="0,0,0,10"
                      SizeChanged="TranscriptDashboardGrid_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="TranscriptDiagnosticsHost"
                            Background="{DynamicResource InputBrush}"
                            BorderBrush="{DynamicResource DisabledBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8,0,0,8"
                            Padding="0"
                            ToolTip="Heuristic live discourse diagnostics. These signals estimate discussion dynamics, not factual correctness.">
                        <Grid>
                        <ScrollViewer x:Name="TranscriptDiagnosticsScroller"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                            <UniformGrid x:Name="TranscriptDiagnosticsGrid"
                                         Columns="6">
                        <Border x:Name="FrictionChip" Style="{StaticResource DashboardMetricChip}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Friction" Style="{StaticResource DashboardMetricLabel}" />
                                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
