<Window x:Class="AIArena.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AIArena.Wpf.Controls"
        Title="AI Arena"
        Icon="/Assets/ai-arena-icon.ico"
        Width="1500"
        Height="860"
        MinWidth="960"
        MinHeight="540"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="MainWindow_SizeChanged"
        Background="{DynamicResource AppBackgroundBrush}">
    <WindowChrome.WindowChrome>
        <!-- The shell owns the caption band: the top bar doubles as the title bar and
             interactive regions opt back in via IsHitTestVisibleInChrome. -->
        <WindowChrome CaptionHeight="44"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101916" />
        <SolidColorBrush x:Key="TopBarBrush" Color="#1A2621" />
        <SolidColorBrush x:Key="PanelBrush" Color="#18231F" />
        <SolidColorBrush x:Key="CardBrush" Color="#14201B" />
        <SolidColorBrush x:Key="InputBrush" Color="#0D1714" />
        <SolidColorBrush x:Key="TranscriptHeaderBrush" Color="#18231F" />
        <SolidColorBrush x:Key="TranscriptBodyBrush" Color="#14201B" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#4D6A5F" />
        <SolidColorBrush x:Key="TextBrush" Color="#DDE7E2" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B8C7BF" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#105444" />
        <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#2EA889" />
        <SolidColorBrush x:Key="AssistBrush" Color="#492337" />
        <SolidColorBrush x:Key="AssistBorderBrush" Color="#E17DB6" />
        <SolidColorBrush x:Key="DangerBrush" Color="#432827" />
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#D66F72" />
        <SolidColorBrush x:Key="DangerTextBrush" Color="#FF7B82" />
        <SolidColorBrush x:Key="DisabledBrush" Color="#111917" />
        <SolidColorBrush x:Key="DisabledBorderBrush" Color="#27342F" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#6F7D76" />
        <SolidColorBrush x:Key="HoverBorderBrush" Color="#56C0A2" />
        <SolidColorBrush x:Key="NavHoverBrush" Color="#122D28" />
        <SolidColorBrush x:Key="NavActiveBrush" Color="#16362F" />
        <SolidColorBrush x:Key="NavPressedBrush" Color="#0F2521" />
        <SolidColorBrush x:Key="PressedPrimaryBrush" Color="#0E3E34" />
        <SolidColorBrush x:Key="OverlayBrush" Color="#CC1A2621" />
        <SolidColorBrush x:Key="AlphaAccentBrush" Color="#4DD4EF" />
        <SolidColorBrush x:Key="BetaAccentBrush" Color="#F0C36A" />
        <SolidColorBrush x:Key="GammaAccentBrush" Color="#7DD98B" />
        <SolidColorBrush x:Key="DeltaAccentBrush" Color="#9EA6FF" />
        <SolidColorBrush x:Key="NarratorAccentBrush" Color="#E17DB6" />
        <SolidColorBrush x:Key="OperatorAccentBrush" Color="#7FB7FF" />
        <!-- The shell adopts the Arena control system; keyed styles below layer intent on top. -->
        <Style TargetType="Button" BasedOn="{StaticResource Arena.Button.Base}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource Arena.TextBox}" />
        <Style TargetType="PasswordBox" BasedOn="{StaticResource Arena.PasswordBox}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource Arena.ComboBox}" />
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Arena.ComboBoxItem}" />
        <Style x:Key="RoleModelComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="IsTextSearchEnabled" Value="False" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="ToolTip" Value="Pick an advertised provider model, type one manually, or leave blank to use default." />
            <EventSetter Event="SelectionChanged" Handler="ParticipantModelText_SelectionChanged" />
            <EventSetter Event="LostKeyboardFocus" Handler="ParticipantModelText_Commit" />
            <EventSetter Event="KeyDown" Handler="ParticipantModelText_KeyDown" />
        </Style>
        <Style x:Key="FormComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style x:Key="FormPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style x:Key="CompactComboBox" TargetType="ComboBox" BasedOn="{StaticResource FormComboBox}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <!-- Slider thumbs only; scrollbars carry their own thumb via Arena.ScrollBar. -->
        <Style TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Arena.Radius.Small}"
                                Margin="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource PrimaryBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Window scrollbars use the shared Arena chrome. -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Arena.ScrollBar}" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="PanelSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Arena.Surface.Card}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="ContentFrame" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="AgentWorkspaceStrip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="AgentConversationFrame" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="AgentComposerPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MaxWidth" Value="900" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AgentComposerTextBox" TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="MinHeight" Value="74" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="AgentComposerChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,5,5" />
        </Style>
        <Style x:Key="AgentAutonomyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BetaAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BetaAccentBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,5,5" />
        </Style>
        <Style x:Key="AgentControlsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="CollaborateToolExpander" TargetType="Expander" BasedOn="{StaticResource AgentControlsExpander}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style x:Key="SessionOverviewHotspot" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="38" />
            <EventSetter Event="KeyDown" Handler="SessionOverviewHotspot_KeyDown" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Arena.Brush.FocusRing}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LeftRailSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SessionMetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SessionMetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="FilterChipCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Arena.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ChipBorder"
                                Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="ChipMark"
                                        Width="10"
                                        Height="10"
                                        CornerRadius="2"
                                        Background="{DynamicResource DisabledBorderBrush}"
                                        Margin="0,0,7,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
                                <Setter TargetName="ChipMark" Property="Background" Value="{DynamicResource PrimaryBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource Arena.Brush.FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleSwitchCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Arena.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="0,0,10,0" />
                            <Border x:Name="SwitchTrack"
                                    Grid.Column="1"
                                    Width="38"
                                    Height="20"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource InputBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                <Border x:Name="SwitchThumb"
                                        Width="14"
                                        Height="14"
                                        HorizontalAlignment="Left"
                                        Margin="3,0,0,0"
                                        Background="{DynamicResource MutedTextBrush}"
                                        CornerRadius="8" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
                                <Setter TargetName="SwitchThumb" Property="Background" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource Arena.Brush.FocusRing}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource DisabledBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                                <Setter TargetName="SwitchThumb" Property="Background" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter Property="Opacity" Value="0.74" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBorderBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="52,0,72,0" />
            <Setter Property="Tag" Value="Search transcripts, agents, notes..." />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Margin="52,0,72,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource TemplatedParent}}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{DynamicResource Arena.Brush.FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Arena.FocusVisual}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavButtonBorder" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                <Setter TargetName="NavButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="NavButtonBorder" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                <Setter TargetName="NavButtonBorder" Property="BorderBrush" Value="{DynamicResource Arena.Brush.FocusRing}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavButtonBorder" Property="Background" Value="{DynamicResource NavPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavButtonBorder" Property="Background" Value="Transparent" />
                                <Setter TargetName="NavButtonBorder" Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
        </Style>
        <Style x:Key="RightRailCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="AgentRailCard" TargetType="Border" BasedOn="{StaticResource RightRailCard}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style x:Key="AssistButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AssistBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AssistBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BetaAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BetaAccentBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
