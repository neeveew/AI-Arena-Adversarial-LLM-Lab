                                  ToolTip="Choose what appears above the transcript cards.">
                            <ComboBoxItem Content="Discourse diagnostics" Tag="diagnostics" />
                            <ComboBoxItem Content="System telemetry" Tag="telemetry" />
                            <ComboBoxItem Content="Hidden" Tag="hidden" />
                        </ComboBox>
                        <TextBlock Text="Experimental controls" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="DebugControlsCheckBox"
                                  Content="Allow debug controls"
                                  Style="{StaticResource ToggleSwitchCheckBox}"
                                  Foreground="{DynamicResource TextBrush}"
                                  FontWeight="SemiBold"
                                  Checked="VisualSettings_Changed"
                                  Unchecked="VisualSettings_Changed"
                                  Margin="0,0,0,6"
                                  ToolTip="Show the top-rail Debug menu for experimental diagnostics. Remembered across restarts." />
                        <TextBlock Text="Debug controls expose optional diagnostics, AI World, and other experimental tools without cluttering the default shell."
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander Header="PowerShell Control" Tag="&#xE756;" Style="{StaticResource SettingsExpander}" IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                        <CheckBox x:Name="ControlPlaneCheckBox"
                                  Content="PowerShell control plane"
                                  Style="{StaticResource ToggleSwitchCheckBox}"
                                  Foreground="{DynamicResource TextBrush}"
                                  FontWeight="SemiBold"
                                  Checked="ControlPlaneCheckBox_Changed"
                                  Unchecked="ControlPlaneCheckBox_Changed"
                                  Margin="0,0,0,8"
                                  AutomationProperties.Name="Toggle AI Arena control plane"
                                  AutomationProperties.HelpText="Enable or disable authenticated local PowerShell automation. Enabled by default."
                                  ToolTip="Enable authenticated local PowerShell control, state inspection, and event streaming" />
                        <TextBlock Text="Enabled by default. Commands use a per-run token and the local named pipe; turn this off to stop PowerShell automation for this app instance."
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander Header="Internet Access" Tag="&#xE774;" Style="{StaticResource SettingsExpander}" IsExpanded="False">
