<Window x:Class="AIArena.Wpf.TextEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit"
        Icon="/Assets/ai-arena-icon.ico"
        Width="620"
        Height="430"
        MinWidth="320"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- Dialog actions share the Arena button system with a taller dialog hit target. -->
        <Style x:Key="DialogActionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource Arena.Button.Base}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="DialogCloseButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DialogActionButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="DialogEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="EditorSurface"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                                  VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                                    <TextBlock x:Name="Watermark"
                                               Margin="2,0,10,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               IsHitTestVisible="False"
                                               Opacity="0.72"
                                               Text="{TemplateBinding Tag}"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Border x:Name="EditorFocusRing"
                                    BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="9"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditorSurface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="EditorFocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter TargetName="EditorFocusRing" Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                <Setter TargetName="EditorFocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter TargetName="EditorSurface" Property="Background" Value="{DynamicResource DisabledBrush}" />
                                <Setter TargetName="EditorSurface" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogShell"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource PrimaryBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True"
            PreviewMouseLeftButtonDown="DialogShell_PreviewMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Color="#000000"
                              Direction="270"
                              Opacity="0.48"
                              ShadowDepth="7" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar"
                    Padding="14,10"
                    Background="{DynamicResource InputBrush}"
                    CornerRadius="11,11,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="EditorBadge"
                            Width="32"
                            Height="32"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource PrimaryBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="20">
                        <TextBlock x:Name="EditorGlyph"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="Text editor"
                                   FontFamily="{DynamicResource Arena.Type.IconFontFamily}"
                                   FontSize="15"
                                   Text="&#xE70F;" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubtitleText"
                                   Margin="0,4,0,0"
                                   MaxHeight="40"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12"
                       Text="Applying updates also locks this item."
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            Click="CancelButton_Click"
                            AutomationProperties.Name="Close text editor"
                            AutomationProperties.HelpText="Closes the editor without applying changes."
                            ToolTip="Close text editor" />
                </Grid>
            </Border>

            <Border x:Name="EditorPanel"
                    Grid.Row="1"
                    Margin="14,10"
                    Padding="1"
                    MinHeight="112"
                    Background="{DynamicResource InputBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="EditText"
                             Margin="8,6,8,0"
                             MinHeight="70"
                             Style="{StaticResource DialogEditorStyle}"
                             AcceptsReturn="True"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             Tag="Enter the text to use."
                             PreviewKeyDown="EditText_PreviewKeyDown"
                             AutomationProperties.Name="Editable text"
                             AutomationProperties.HelpText="Edit the text. Press Control+Enter to apply."
                             AutomationProperties.LabeledBy="{Binding ElementName=TitleText}" />
                    <Grid Grid.Row="1"
                          Margin="10,5,10,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="EditorShortcutText"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11"
                                   Text="Ctrl+Enter applies · Esc cancels"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="EditorCountText"
                                   Grid.Column="1"
                                   Margin="16,0,0,0"
                                   AutomationProperties.Name="Character count"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11"
                                   Text="{Binding Text.Length, ElementName=EditText, StringFormat={}{0:N0} characters}" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="FooterBar"
                    Grid.Row="2"
                    Padding="14,10"
                    Background="{DynamicResource InputBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11">
                <Grid x:Name="EditActionHost">
                    <Grid HorizontalAlignment="Right"
                          Width="{Binding ActualWidth, ElementName=EditActionHost}"
                          MaxWidth="340">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CancelButton"
                                Height="36"
                                Style="{StaticResource DialogActionButtonStyle}"
                                Content="Cancel"
                                Click="CancelButton_Click"
                                IsCancel="True"
                                AutomationProperties.Name="Cancel text changes"
                                AutomationProperties.HelpText="Closes the editor without applying changes."
                                ToolTip="Cancel text changes" />
                        <Button x:Name="ApplyButton"
                                Grid.Column="2"
                                Height="36"
                                Style="{StaticResource DialogActionButtonStyle}"
                                Content="Apply"
                                Click="ApplyButton_Click"
                                IsDefault="True"
                                AutomationProperties.Name="Apply text changes"
                                AutomationProperties.HelpText="Applies the edited text."
                                ToolTip="Apply text changes (Control+Enter)" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
