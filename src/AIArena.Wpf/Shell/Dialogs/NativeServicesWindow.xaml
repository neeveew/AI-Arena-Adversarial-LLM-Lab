<Window x:Class="AIArena.Wpf.NativeServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Native services" Icon="/AI Arena;component/Assets/ai-arena-icon.ico"
        Width="850" Height="800" MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource Arena.Type.FontFamily}"
        FontSize="{DynamicResource Arena.Type.BodySize}"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="Native services"
        AutomationProperties.HelpText="Choose a native model, run an inference, or create a diagnostic bundle. Closing this window only stops observation."
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AI Arena;component/UI/Theming/ThemeBrushes.xaml" />
                <ResourceDictionary Source="/AI Arena;component/UI/Theming/DesignTokens.xaml" />
                <ResourceDictionary Source="/AI Arena;component/UI/Theming/ControlStyles.xaml" />
                <ResourceDictionary Source="/AI Arena;component/UI/Theming/SurfaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="NativeBooleanVisibility" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="{DynamicResource Arena.Inset.None}" />
            <Setter Property="Margin" Value="{DynamicResource Arena.Layout.FieldLabelMargin}" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource Arena.Button.Secondary}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="{DynamicResource Arena.Gap.Wrap.After.Compact}" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Arena.TextBox}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource Arena.ComboBox}" />
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Arena.ComboBoxItem}" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Arena.ScrollBar}" />
        <Style x:Key="NativePrimaryAction" TargetType="Button" BasedOn="{StaticResource Arena.Button.Primary}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="{DynamicResource Arena.Gap.Wrap.After.Compact}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Padding" Value="{DynamicResource Arena.Inset.InteractiveCard}" />
            <Setter Property="Margin" Value="{DynamicResource Arena.Gap.Inline.After.Compact}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Arena.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource Arena.Radius.Medium}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource NavActiveBrush}" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0"
                                      Margin="{DynamicResource Arena.Gap.Stack.After.Default}" />
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NativeEvidenceCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Arena.Radius.Medium}" />
            <Setter Property="Padding" Value="{DynamicResource Arena.Inset.Panel}" />
            <Setter Property="Margin" Value="{DynamicResource Arena.Gap.Stack.After.Section}" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="{DynamicResource Arena.Inset.Section}" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Native services" FontSize="{DynamicResource Arena.Type.PageTitleSize}" FontWeight="SemiBold" />
            <TextBlock Text="Choose a native model, run an inference, or collect diagnostics."
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="{DynamicResource Arena.Layout.WorkspaceDescriptionMargin}" />
            <WrapPanel>
                <Button x:Name="ConnectButton" Content="_Connect / Refresh" Click="Connect_Click"
                        IsEnabled="{Binding CanConnect}" AutomationProperties.Name="Connect or refresh native services" />
            </WrapPanel>
            <TextBlock Text="{Binding HealthSummary}" Foreground="{DynamicResource MutedTextBrush}"
                       Margin="{DynamicResource Arena.Gap.Stack.After.Default}" AutomationProperties.Name="Native connection status" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="{DynamicResource Arena.Gap.Stack.Before.Section}">
            <Button DockPanel.Dock="Right" Content="C_lose" Click="Close_Click"
                    AutomationProperties.Name="Close native services" />
            <TextBlock Text="Closing this window stops observation. The native app continues to own its operations."
                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
        </DockPanel>
        <TabControl x:Name="NativeServicesTabs" SelectedIndex="0" AutomationProperties.Name="Native service workspaces">
            <TabItem x:Name="ModelsTab" Header="Models &amp; inference" AutomationProperties.Name="Models and inference">
                <Grid x:Name="ModelsSurface" DataContext="{Binding Models}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="ModelsScrollViewer" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <Border Style="{StaticResource NativeEvidenceCard}">
                                <StackPanel>
                                    <TextBlock Text="Native model" FontWeight="SemiBold" FontSize="{DynamicResource Arena.Type.HeadingSize}" />
                                    <Label Content="_Model" Target="{Binding ElementName=NativeModelPicker}" />
                                    <ComboBox x:Name="NativeModelPicker" ItemsSource="{Binding Items}"
                                              SelectedItem="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanSelectModel}" MinHeight="36" MaxDropDownHeight="240"
                                              AutomationProperties.Name="Native model selection"
                                              AutomationProperties.HelpText="Choose a model managed by the native app. Availability and residency come from its latest inventory.">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock x:Name="NativeModelSummary" Text="{Binding ModelSummary}"
                                               Margin="{DynamicResource Arena.Gap.Stack.Before.Default}" />
                                    <WrapPanel Margin="{DynamicResource Arena.Gap.Stack.Before.Default}">
                                        <Button x:Name="LoadNativeModelButton" Content="Lo_ad model" Click="LoadModel_Click"
                                                IsEnabled="{Binding CanLoadModel}" AutomationProperties.Name="Load selected native model" />
                                        <Button x:Name="UnloadNativeModelButton" Content="_Unload model" Click="UnloadModel_Click"
                                                IsEnabled="{Binding CanUnloadModel}" AutomationProperties.Name="Unload selected native model" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NativeEvidenceCard}">
                                <StackPanel>
                                    <TextBlock Text="Inference" FontWeight="SemiBold" FontSize="{DynamicResource Arena.Type.HeadingSize}" />
                                    <Label Content="_Prompt" Target="{Binding ElementName=NativePromptBox}" />
                                    <TextBox x:Name="NativePromptBox" Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditPrompt}" AcceptsReturn="True" MinHeight="110" MaxHeight="200"
                                             AutomationProperties.Name="Native inference prompt"
                                             AutomationProperties.HelpText="Write the prompt for the selected native model. The submitted prompt is retained while its outcome is unresolved." />
                                    <Label Content="Response" Target="{Binding ElementName=NativeOutputBox}" />
                                    <TextBox x:Name="NativeOutputBox" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True"
                                             MinHeight="160" MaxHeight="360" AutomationProperties.Name="Native inference response"
                                             AutomationProperties.HelpText="Read-only model output. Select text to copy it. Operation status identifies incomplete or canceled results." />
                                </StackPanel>
                            </Border>
                            <Expander Header="Operation details" Foreground="{DynamicResource TextBrush}"
                                      Margin="{DynamicResource Arena.Gap.Stack.After.Default}" AutomationProperties.Name="Model operation details">
                                <StackPanel Margin="{DynamicResource Arena.Gap.Stack.Before.Default}">
                                    <Label Content="Operation ID" Target="{Binding ElementName=ModelOperationIdBox}" />
                                    <TextBox x:Name="ModelOperationIdBox" Text="{Binding OperationId, Mode=OneWay}" IsReadOnly="True"
                                             AutomationProperties.Name="Native model operation ID" />
                                    <TextBlock Text="{Binding OperationSummary}" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="NativeInferenceActions" Grid.Row="1" Style="{StaticResource NativeEvidenceCard}"
                            Margin="{DynamicResource Arena.Gap.Stack.Before.Default}">
                        <StackPanel>
                            <Border Visibility="{Binding CanConfirmLoad, Converter={StaticResource NativeBooleanVisibility}}"
                                    Background="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                                    BorderThickness="1" Padding="{DynamicResource Arena.Inset.Card}"
                                    CornerRadius="{DynamicResource Arena.Radius.Medium}" Margin="{DynamicResource Arena.Gap.Stack.After.Default}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ConfirmationSummary}" AutomationProperties.LiveSetting="Polite"
                                               AutomationProperties.Name="Native model load confirmation reason" />
                                    <Button x:Name="ConfirmNativeModelLoadButton" Content="Load any_way" Click="ConfirmModelLoad_Click"
                                            IsEnabled="{Binding CanConfirmLoad}" HorizontalAlignment="Left"
                                            Margin="{DynamicResource Arena.Gap.Stack.Before.Default}"
                                            AutomationProperties.Name="Confirm native model load despite capacity warning" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="NativeInferenceMessage" Text="{Binding Message}"
                                       Margin="{DynamicResource Arena.Gap.Stack.After.Default}" AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Native model and inference status" />
                            <WrapPanel>
                                <Button x:Name="StartNativeInferenceButton" Content="_Start inference" Style="{StaticResource NativePrimaryAction}"
                                        Click="StartInference_Click" IsEnabled="{Binding CanStartInference}" AutomationProperties.Name="Start native inference" />
                                <Button x:Name="RetryNativeModelButton" Content="_Retry same request" Click="RetryModelRequest_Click"
                                        IsEnabled="{Binding CanRetryPendingRequest}" AutomationProperties.Name="Retry the same native model request"
                                        ToolTip="Recover the original model or inference request using its unchanged inputs." />
                                <Button x:Name="ObserveNativeModelButton" Content="Observe pro_gress" Click="ObserveModel_Click"
                                        IsEnabled="{Binding CanObserve}" AutomationProperties.Name="Observe native model operation progress" />
                                <Button x:Name="StopObservingNativeModelButton" Content="Stop obser_ving" Click="StopObservingModel_Click"
                                        IsEnabled="{Binding IsObserving}" AutomationProperties.Name="Stop observing native model operation without canceling"
                                        ToolTip="Stops local updates. The native model operation continues." />
                                <Button x:Name="RefreshNativeModelButton" Content="Refres_h status" Click="RefreshModel_Click"
                                        IsEnabled="{Binding CanRefresh}" AutomationProperties.Name="Refresh native models and operation status" />
                                <Button x:Name="CancelNativeModelButton" Content="Ca_ncel operation" Click="CancelModel_Click"
                                        IsEnabled="{Binding CanCancel}" AutomationProperties.Name="Request native model operation cancellation"
                                        ToolTip="Ask the native app to cancel this model or inference operation. Completion may happen first." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="DiagnosticsTab" Header="Diagnostics" AutomationProperties.Name="Diagnostics">
        <ScrollViewer x:Name="DiagnosticsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <Border Style="{StaticResource NativeEvidenceCard}">
                    <StackPanel>
                        <TextBlock Text="Connection evidence" FontWeight="SemiBold" FontSize="{DynamicResource Arena.Type.HeadingSize}" />
                        <Label Content="Health" />
                        <TextBlock Text="{Binding HealthSummary}" AutomationProperties.Name="Native health" />
                        <Label Content="Models" />
                        <TextBlock Text="{Binding ModelsSummary}" AutomationProperties.Name="Native models" />
                        <Label Content="Operations" />
                        <TextBlock Text="{Binding OperationsSummary}" AutomationProperties.Name="Native operations" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource NativeEvidenceCard}">
                    <StackPanel>
                        <TextBlock Text="Diagnostic bundle" FontWeight="SemiBold" FontSize="{DynamicResource Arena.Type.HeadingSize}" />
                        <Label Content="_Destination ZIP" Target="{Binding ElementName=DestinationBox}" />
                        <TextBox x:Name="DestinationBox" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding HasPendingRequest}" IsEnabled="{Binding CanChooseDestination}"
                                 MinHeight="36" MaxHeight="90"
                                 AutomationProperties.Name="Diagnostic ZIP destination"
                                 AutomationProperties.HelpText="Choose a new ZIP file. The destination stays locked while submission or an operation is unresolved." />
                        <WrapPanel Margin="{DynamicResource Arena.Gap.Stack.Before.Default}">
                            <Button Content="_Browse…" Click="Browse_Click" IsEnabled="{Binding CanChooseDestination}"
                                    AutomationProperties.Name="Browse for a new diagnostic ZIP file" />
                            <Button Content="Create _bundle" Click="Create_Click" IsEnabled="{Binding CanCreateBundle}"
                                    AutomationProperties.Name="Create diagnostic bundle" />
                            <Button Content="_Retry same request" Click="Retry_Click" IsEnabled="{Binding CanRetryPendingRequest}"
                                    AutomationProperties.Name="Retry the same unconfirmed request"
                                    ToolTip="Recover the original request using its unchanged destination. This does not request a second bundle." />
                        </WrapPanel>
                        <TextBlock Text="{Binding Message}" Margin="{DynamicResource Arena.Gap.Stack.Before.Default}"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Native services status" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource NativeEvidenceCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding OperationState}" FontWeight="SemiBold" FontSize="{DynamicResource Arena.Type.HeadingSize}" />
                        <TextBlock Text="{Binding OperationSummary}" Margin="{DynamicResource Arena.Gap.Stack.Before.Compact}" />
                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding ProgressIsIndeterminate}"
                                     Foreground="{DynamicResource PrimaryBorderBrush}" Background="{DynamicResource InputBrush}"
                                     Margin="{DynamicResource Arena.Gap.Stack.Before.Default}"
                                     AutomationProperties.Name="Diagnostic bundle progress" />
                        <Label Content="Operation ID" Target="{Binding ElementName=OperationIdBox}" />
                        <TextBox x:Name="OperationIdBox" Text="{Binding OperationId, Mode=OneWay}" IsReadOnly="True"
                                 AutomationProperties.Name="Native operation ID" />
                        <Label Content="Result path" Target="{Binding ElementName=ResultPathBox}" />
                        <TextBox x:Name="ResultPathBox" Text="{Binding ResultPath, Mode=OneWay}" IsReadOnly="True" MaxHeight="90"
                                 AutomationProperties.Name="Diagnostic bundle result path" />
                        <WrapPanel Margin="{DynamicResource Arena.Gap.Stack.Before.Default}">
                            <Button Content="_Observe progress" Click="Observe_Click" IsEnabled="{Binding CanObserve}"
                                    AutomationProperties.Name="Observe native operation progress" />
                            <Button Content="_Stop observing" Click="StopObserving_Click" IsEnabled="{Binding IsObserving}"
                                    AutomationProperties.Name="Stop observing without canceling"
                                    ToolTip="Stops local progress updates. The native operation continues." />
                            <Button Content="Refresh _status" Click="Reconcile_Click" IsEnabled="{Binding CanReconcile}"
                                    AutomationProperties.Name="Refresh and reconcile native operation status" />
                            <Button Content="Cancel _operation" Click="CancelOperation_Click" IsEnabled="{Binding CanCancel}"
                                    AutomationProperties.Name="Request native operation cancellation"
                                    ToolTip="Ask the native app to cancel. Completion may happen before cancellation." />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
