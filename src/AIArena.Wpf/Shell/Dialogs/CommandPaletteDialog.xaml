<Window x:Class="AIArena.Wpf.CommandPaletteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Commands"
        Icon="/Assets/ai-arena-icon.ico"
        Width="660"
        Height="470"
        MinWidth="380"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border x:Name="DialogShell"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource PrimaryBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True"
            PreviewMouseLeftButtonDown="DialogShell_PreviewMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Color="#000000"
                              Direction="270"
                              Opacity="0.48"
                              ShadowDepth="7" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar"
                    Padding="14,12"
                    Background="{DynamicResource InputBrush}"
                    CornerRadius="11,11,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SearchGlyph"
                               Margin="2,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource Arena.Type.IconFontFamily}"
                               FontSize="15"
                               Text="&#xE721;" />

                    <Grid Grid.Column="1">
                        <TextBox x:Name="QueryText"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Segoe UI Variable Text, Segoe UI"
                                 FontSize="16"
                                 TextChanged="QueryText_TextChanged"
                                 PreviewKeyDown="QueryText_PreviewKeyDown"
                                 AutomationProperties.Name="Search commands"
                                 AutomationProperties.HelpText="Type to filter. Up and Down move the selection, Enter runs it, Escape closes." />

                        <!-- Without this the box reads as an empty void on open,
                             which gives no hint that typing is what you do next. -->
                        <TextBlock x:Name="QueryWatermark"
                                   Margin="2,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="16"
                                   IsHitTestVisible="False"
                                   Opacity="0.66"
                                   Text="Search commands..." />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="10,10"
                    Background="Transparent">
                <Grid>
                    <ListBox x:Name="ResultsList"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="ResultsList_MouseDoubleClick"
                             AutomationProperties.Name="Matching commands">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="14"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="11"
                                                   Opacity="0.72"
                                                   Text="{Binding Group}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,2,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas, Segoe UI"
                                               FontSize="11"
                                               Opacity="0.8"
                                               Text="{Binding Keys}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyText"
                               Margin="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="13"
                               Text="No command matches that."
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border x:Name="FooterBar"
                    Grid.Row="2"
                    Padding="14,9"
                    Background="{DynamicResource InputBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11">
                <TextBlock x:Name="FooterText"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11"
                           Text="Enter runs the selected command · Up and Down move · Esc closes" />
            </Border>
        </Grid>
    </Border>
</Window>
